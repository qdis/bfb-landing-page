---
// ABOUTME: Names the single-vendor remotes BFB replaces, without a GitHub CTA.
// ABOUTME: Cross-provider handoff is the product difference.

import { COPY } from "../lib/copy";
---

<section class="different" id="how">
  <h2>{COPY.different.headline}</h2>
  <p>{COPY.different.body}</p>
</section>

<style>
  .different {
    padding: 5.2rem 1.25rem 5rem;
    background: var(--blackout);
    border-top: 1px solid var(--hairline);
  }

  h2 {
    margin: 0 0 1.2rem;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.4vw, 3.5rem);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.04em;
  }

  p {
    margin: 0;
    max-width: 62ch;
    font-size: 1.08rem;
    line-height: 1.55;
    color: var(--smoke);
  }

  @media (min-width: 768px) {
    .different {
      padding: 6.5rem 2rem 6.25rem;
    }
  }
</style>

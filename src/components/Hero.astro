---
// ABOUTME: Full-width mission hero. A slow slash cuts the death lines.
// ABOUTME: Signup is here. Watch the demo jumps to the carded preview.

import { COPY } from "../lib/copy";
import SignupForm from "./SignupForm.astro";

const { line1, line2, line3, spell, sub, demo } = COPY.hero;
---

<section class="hero" id="top">
  <div class="safelight" aria-hidden="true"></div>
  <div class="wrap">
    <h1>
      <span class="deaths" data-slash>
        <span class="blade" aria-hidden="true"></span>
        <span class="line">{line1}</span>
        <span class="line">{line2}</span>
      </span>
      <span class="need">{line3}</span>
      <span class="spell">{spell}</span>
    </h1>
    <p>{sub}</p>
    <div class="actions">
      <SignupForm loud fieldId="hero-email" />
      <a class="alt" href="#demo">{demo}</a>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector("[data-slash]");
  if (root instanceof HTMLElement) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      root.classList.add("cut-done");
    } else {
      requestAnimationFrame(() => root.classList.add("slash-go"));
      const blade = root.querySelector(".blade");
      const finish = () => root.classList.add("cut-done");
      if (blade) {
        blade.addEventListener("animationend", finish, { once: true });
      }
      window.setTimeout(finish, 1900);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100dvh - var(--nav-h));
    overflow: hidden;
    background: var(--blackout);
  }

  .safelight {
    position: absolute;
    inset: 0 0 0 48%;
    z-index: 0;
    background: var(--oxblood);
    clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 100%);
  }

  .wrap {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100dvh - var(--nav-h));
    padding: 2rem 0 2.5rem;
  }

  h1 {
    margin: 0;
    display: grid;
    gap: 0.12em;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7.4vw, 6.4rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .deaths {
    position: relative;
    display: grid;
    gap: 0.06em;
    overflow: hidden;
    padding: 0.12em 0.08em 0.22em 0;
  }

  .line {
    display: block;
  }

  .deaths::after {
    content: "";
    position: absolute;
    left: -1%;
    top: 46%;
    z-index: 3;
    width: 102%;
    height: 0.045em;
    background: var(--crimson);
    box-shadow: 0 0 0.45rem color-mix(in oklab, var(--crimson) 70%, transparent);
    transform: rotate(-8deg) scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }

  .deaths.cut-done::after,
  .deaths.slash-go::after {
    transform: rotate(-8deg) scaleX(1);
  }

  .blade {
    position: absolute;
    left: -14%;
    top: 18%;
    z-index: 4;
    width: 130%;
    height: 0.09em;
    background: linear-gradient(
      90deg,
      transparent 0%,
      white 22%,
      var(--crimson) 52%,
      transparent 100%
    );
    box-shadow: 0 0 0.7rem color-mix(in oklab, var(--crimson) 75%, transparent);
    transform: rotate(-8deg) translateX(-120%);
    pointer-events: none;
  }

  .need {
    display: block;
    color: var(--safelight);
    font-size: 0.38em;
    line-height: 1.05;
    letter-spacing: -0.035em;
    max-width: 22ch;
    padding-top: 0.45em;
  }

  .spell {
    display: block;
    padding-top: 0.35em;
    max-width: 22ch;
    font-size: 0.2em;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.15;
    color: var(--bone);
  }

  p {
    margin: 1.3rem 0 0;
    max-width: 28ch;
    font-size: 1.08rem;
    line-height: 1.45;
    color: var(--smoke);
    hyphens: none;
  }

  .actions {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.7rem;
    max-width: 26rem;
  }

  .alt {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 2.5rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-control);
    color: var(--bone);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .alt:hover {
    border-color: var(--crimson);
    color: var(--safelight);
  }

  @media (prefers-reduced-motion: no-preference) {
    .deaths.slash-go .blade {
      animation: slash 1.55s cubic-bezier(0.22, 0.7, 0.2, 1) forwards;
    }

    .deaths.slash-go::after {
      animation: wound 1.55s cubic-bezier(0.22, 0.7, 0.2, 1) forwards;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deaths::after {
      transform: rotate(-8deg) scaleX(1);
    }

    .blade {
      display: none;
    }
  }

  @keyframes slash {
    to {
      transform: rotate(-8deg) translateX(16%);
      opacity: 0;
    }
  }

  @keyframes wound {
    to {
      transform: rotate(-8deg) scaleX(1);
    }
  }
</style>

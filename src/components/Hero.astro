---
// ABOUTME: First viewport from the official Redline mockup.
// ABOUTME: Left manifesto, oxblood field, perspective plane, one Get BFB action.

import { COPY } from "../lib/copy";
import HeroPlane from "./HeroPlane.astro";

const { sub, cta } = COPY.hero;
---

<section class="hero" id="top">
  <div class="safelight" aria-hidden="true"></div>
  <div class="grid">
    <div class="manifesto">
      <h1>THE TICKET<br />ERA IS OVER.</h1>
      <p>{sub}</p>
      <a class="cta" href="#signup">{cta}</a>
    </div>
    <div class="stage">
      <div class="tilt">
        <HeroPlane />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100dvh - var(--nav-h));
    overflow: hidden;
    background: var(--blackout);
  }

  .safelight {
    position: absolute;
    inset: 0 0 0 34%;
    z-index: 0;
    background: var(--oxblood);
    clip-path: polygon(20% 0, 100% 0, 100% 100%, 0 100%);
  }

  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: calc(100dvh - var(--nav-h));
    grid-template-columns: 1fr;
  }

  .manifesto {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.5rem 1.25rem 1.75rem;
    max-width: 38rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5.4vw, 4.7rem);
    font-weight: 700;
    line-height: 0.94;
    letter-spacing: -0.035em;
  }

  p {
    margin: 1.15rem 0 0;
    max-width: 34ch;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--smoke);
  }

  .cta {
    margin-top: 1.6rem;
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 2.75rem;
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-control);
    background: var(--crimson);
    color: var(--bone);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cta:hover {
    background: var(--safelight);
    color: var(--blackout);
  }

  .cta:active {
    transform: translateY(1px);
  }

  .stage {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 0 0 0 1rem;
    min-height: 22rem;
  }

  .tilt {
    width: 100%;
    display: flex;
    justify-content: flex-end;
  }

  @media (prefers-reduced-motion: no-preference) {
    .manifesto {
      animation: rise 560ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .tilt {
      animation: expose 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes expose {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 1023px) {
    .safelight {
      inset: auto 0 0 0;
      height: 48%;
      clip-path: none;
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: minmax(300px, 40%) minmax(0, 1fr);
    }

    .manifesto {
      padding: 1.5rem 1.75rem 2.5rem 2.25rem;
    }

    .stage {
      align-items: center;
      padding: 1.1rem 1.6rem 1.35rem 0;
      min-height: 0;
    }

    .tilt {
      width: 100%;
      transform: perspective(1800px) rotateY(-11deg) rotateX(4deg);
      transform-origin: 70% 55%;
    }

    .tilt :global(.plane) {
      width: 100%;
      max-width: none;
    }
  }
</style>

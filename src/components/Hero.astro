---
// ABOUTME: Full-width mission hero. No board. The demo lives in the next section.
// ABOUTME: Get BFB signs up. Watch the demo jumps to the scripted board.

import { COPY } from "../lib/copy";

const { line1, line2, line3, sub, cta } = COPY.hero;
---

<section class="hero" id="top">
  <div class="safelight" aria-hidden="true"></div>
  <div class="wrap">
    <h1>
      <span>{line1}</span>
      <span>{line2}</span>
      <span class="need">{line3}</span>
    </h1>
    <p>{sub}</p>
    <div class="actions">
      <a class="cta" href="#signup">{cta}</a>
      <a class="alt" href="#demo">Watch the demo</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100dvh - var(--nav-h));
    overflow: hidden;
    background: var(--blackout);
  }

  .safelight {
    position: absolute;
    inset: 0 0 0 48%;
    z-index: 0;
    background: var(--oxblood);
    clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 100%);
  }

  .wrap {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100dvh - var(--nav-h));
    padding: 2rem 0 2.5rem;
  }

  h1 {
    margin: 0;
    display: grid;
    gap: 0.1em;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8.4vw, 7.2rem);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.05em;
  }

  h1 span {
    display: block;
  }

  .need {
    color: var(--safelight);
    font-size: 0.38em;
    line-height: 1.05;
    letter-spacing: -0.035em;
    max-width: 18ch;
    padding-top: 0.45em;
  }

  p {
    margin: 1.3rem 0 0;
    max-width: 28ch;
    font-size: 1.08rem;
    line-height: 1.45;
    color: var(--smoke);
    hyphens: none;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.6rem;
  }

  .cta,
  .alt {
    display: inline-flex;
    align-items: center;
    min-height: 2.7rem;
    padding: 0.8rem 1.2rem;
    border-radius: var(--radius-control);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cta {
    background: var(--crimson);
    color: var(--bone);
  }

  .alt {
    border: 1px solid var(--hairline);
    color: var(--bone);
  }

  .cta:hover {
    background: var(--safelight);
    color: var(--blackout);
  }

  .alt:hover {
    border-color: var(--bone);
  }

  .cta:active,
  .alt:active {
    transform: translateY(1px);
  }
</style>

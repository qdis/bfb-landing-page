---
// ABOUTME: Mission-statement hero. Death lines on the left, live board on the right.
// ABOUTME: Third line names the replacement: a control plane for AI-first companies.

import { COPY } from "../lib/copy";
import HeroPlane from "./HeroPlane.astro";

const { line1, line2, line3, sub, cta } = COPY.hero;
---

<section class="hero" id="top">
  <div class="safelight" aria-hidden="true"></div>
  <div class="wrap grid">
    <div class="manifesto">
      <h1>
        <span>{line1}</span>
        <span>{line2}</span>
        <span class="need">{line3}</span>
      </h1>
      <p>{sub}</p>
      <a class="cta" href="#signup">{cta}</a>
    </div>
    <div class="stage">
      <HeroPlane />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100dvh - var(--nav-h));
    overflow: hidden;
    background: var(--blackout);
  }

  .safelight {
    position: absolute;
    inset: 0 0 0 32%;
    z-index: 0;
    background: var(--oxblood);
    clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%);
  }

  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: calc(100dvh - var(--nav-h));
    grid-template-columns: 1fr;
  }

  .manifesto {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.35rem 0 1.5rem;
    max-width: 40rem;
  }

  h1 {
    margin: 0;
    display: grid;
    gap: 0.12em;
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 4.6vw, 4.15rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  h1 span {
    display: block;
  }

  .need {
    color: var(--safelight);
    font-size: 0.52em;
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 16ch;
    padding-top: 0.35em;
  }

  p {
    margin: 1.15rem 0 0;
    max-width: 32ch;
    font-size: 1.02rem;
    line-height: 1.45;
    color: var(--smoke);
    hyphens: none;
  }

  .cta {
    margin-top: 1.45rem;
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 2.7rem;
    padding: 0.8rem 1.2rem;
    border-radius: var(--radius-control);
    background: var(--crimson);
    color: var(--bone);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cta:hover {
    background: var(--safelight);
    color: var(--blackout);
  }

  .cta:active {
    transform: translateY(1px);
  }

  .stage {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 0 0.75rem 0.75rem;
    min-height: 22rem;
  }

  @media (max-width: 1023px) {
    .safelight {
      inset: auto 0 0 0;
      height: 46%;
      clip-path: none;
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: minmax(280px, 38%) minmax(0, 1fr);
    }

    .manifesto {
      padding: 1.4rem 1.25rem 2rem 0;
    }

    .stage {
      align-items: center;
      padding: 1rem 0 1.2rem 0;
      min-height: 0;
    }
  }
</style>

---
// ABOUTME: Public Notice product fixture: Needs Now deck over project lanes.
// ABOUTME: Demonstration data from the BFB design study. Lanes are projects, never status columns.

const needs = [
  {
    project: "BFB MAC",
    priority: "P0 BLOCKING",
    title: "Approve runner wake",
    now: "Claude is blocked on your runner approval.",
    why: "You own this runner.",
    gate: "WHY TIMO",
    action: "APPROVE",
  },
  {
    project: "BFB CORE",
    priority: "P1 HIGH",
    title: "Choose review policy",
    now: "Codex can prepare the comparison. You own the product decision.",
    why: "Codex can prepare the comparison.",
    gate: "AGENT CAN PREPARE",
    action: "PASS TO CODEX",
  },
  {
    project: "BFB CLOUD",
    priority: "P1 HIGH",
    title: "Review reconnect plan",
    now: "Grok can review the event gaps. No human permission is required.",
    why: "No human permission is required.",
    gate: "AGENT REVIEW WORKS",
    action: "PASS TO GROK",
  },
];

const lanes = [
  {
    name: "BFB CORE",
    slot: "01",
    tasks: [
      {
        title: "Route review to another agent",
        priority: "P1 HIGH",
        now: "Claude is waiting for your product choice.",
        meta: "Claude / waiting 22m",
        time: "Agent 1h05 / Human 12m",
        pin: true,
      },
      {
        title: "Context versioning",
        priority: "P2 NORMAL",
        now: "Codex is validating context hashes.",
        meta: "Codex / working",
        time: "Agent 48m / Human 6m",
      },
    ],
  },
  {
    name: "BFB MAC",
    slot: "02",
    tasks: [
      {
        title: "Approve runner wake",
        priority: "P0 BLOCKING",
        now: "Claude is blocked on your runner approval.",
        meta: "Claude / waiting 22m",
        time: "Pinned above",
        pin: true,
      },
      {
        title: "Block launch when checkout is occupied",
        priority: "P1 HIGH",
        now: "Codex is running checkout lease tests. Next: Claude review.",
        meta: "Codex / working",
        time: "Agent 42m / Human 4m",
      },
    ],
  },
  {
    name: "BFB CLOUD",
    slot: "03",
    tasks: [
      {
        title: "Replay live events after reconnect",
        priority: "P1 HIGH",
        now: "Checkpoint missed by 18m. Grok is still working.",
        meta: "Grok / working",
        time: "Checkpoint behind 18m",
      },
      {
        title: "Browser high-water replay",
        priority: "P2 NORMAL",
        now: "Claude Review is checking event gaps.",
        meta: "Claude / reviewing",
        time: "Agent 24m / Human 0m",
      },
    ],
  },
  {
    name: "ARTIFACTS",
    slot: "04",
    tasks: [
      {
        title: "Review Mermaid sandbox",
        priority: "P1 HIGH",
        now: "Codex can review artifact v3.",
        meta: "Agent review works",
        time: "Pass to Codex",
      },
    ],
  },
];
---

<section class="board" aria-label="Demonstration board. Synthetic workspace data from the BFB design study.">
  <p class="synth">Demonstration board. Synthetic workspace. Not live product data.</p>
  <div class="truth">
    <span>5 agents active</span>
    <span>2 need Timo</span>
    <span>1 checkpoint behind</span>
    <span>Agent work 21h18</span>
    <span>Human work 4h06</span>
  </div>
  <div class="now">
    <h2>Needs Timo now / 3</h2>
    <p>High priority work blocked on you. No pressure.</p>
    <div class="needs">
      {
        needs.map((card) => (
          <article class="need" data-priority={card.priority}>
            <header>
              <span>{card.project}</span>
              <b>{card.priority}</b>
            </header>
            <h3>{card.title}</h3>
            <p class="punch">Now</p>
            <p>{card.now}</p>
            <p class="gate">{card.gate}</p>
            <p>{card.why}</p>
            <span class="act">{card.action}</span>
          </article>
        ))
      }
    </div>
  </div>
  <div class="lanes">
    {
      lanes.map((lane) => (
        <section class={`lane slot-${lane.slot}`}>
          <h3>{lane.name}</h3>
          {
            lane.tasks.map((task) => (
              <article data-priority={task.priority}>
                <header>
                  <b>{task.priority}</b>
                </header>
                <h4>{task.title}</h4>
                <p class="punch">Now</p>
                <p>{task.now}</p>
                <p class="meta">{task.meta}</p>
                <p class="meta">{task.time}</p>
                {task.pin && <p class="meta">Pinned above</p>}
              </article>
            ))
          }
        </section>
      ))
    }
  </div>
</section>

<style>
  .board {
    background: oklch(0.145 0.012 25);
    color: oklch(0.985 0.005 70);
    padding: 0.85rem 1rem 1.1rem;
  }

  .synth,
  .truth,
  .meta,
  .gate,
  .punch,
  .now > p {
    font-family: ui-monospace, "Azeret Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }

  .synth {
    margin: 0 0 0.55rem;
    opacity: 0.7;
  }

  .truth {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 0 0 0.9rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid oklch(0.34 0.018 27);
  }

  .now > h2 {
    margin: 0;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .now > p {
    margin: 0.2rem 0 0.7rem;
    font-family: Archivo, Arial, sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0;
  }

  .needs,
  .lanes {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 1fr);
    gap: 0.65rem;
    overflow-x: auto;
  }

  article {
    border: 1px solid oklch(0.34 0.018 27);
    padding: 0.7rem 0.75rem 0.8rem;
    background: oklch(0.17 0.014 27);
  }

  article header {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 0.35rem;
  }

  article header span {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  article h3,
  article h4,
  .lane > h3 {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .lane > h3 {
    padding-bottom: 0.4rem;
    border-bottom: 3px solid currentColor;
  }

  .slot-01 {
    color: oklch(0.73 0.13 55);
  }
  .slot-02 {
    color: oklch(0.73 0.1 190);
  }
  .slot-03 {
    color: oklch(0.73 0.14 255);
  }
  .slot-04 {
    color: oklch(0.73 0.15 310);
  }

  .lane article {
    color: oklch(0.985 0.005 70);
    margin-top: 0.55rem;
  }

  .slot-01 article {
    border-top: 3px solid oklch(0.73 0.13 55);
  }
  .slot-02 article {
    border-top: 3px solid oklch(0.73 0.1 190);
  }
  .slot-03 article {
    border-top: 3px solid oklch(0.73 0.14 255);
  }
  .slot-04 article {
    border-top: 3px solid oklch(0.73 0.15 310);
  }

  .punch {
    margin: 0;
    text-transform: uppercase;
  }

  article > p {
    margin: 0.15rem 0 0;
    font-size: 0.88rem;
    line-height: 1.35;
  }

  b {
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    font-weight: 700;
    padding: 0.15rem 0.3rem;
    border: 1px solid currentColor;
  }

  [data-priority="P0 BLOCKING"] > header b {
    background: oklch(0.464 0.169 26.9);
    border-color: oklch(0.464 0.169 26.9);
    color: oklch(0.985 0.005 70);
  }

  [data-priority="P1 HIGH"] > header b {
    color: oklch(0.78 0.14 55);
    border-color: oklch(0.78 0.14 55);
  }

  .act {
    display: inline-block;
    margin-top: 0.55rem;
    border: 1px solid oklch(0.985 0.005 70);
    padding: 0.35rem 0.55rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .need[data-priority="P0 BLOCKING"] .act {
    background: oklch(0.464 0.169 26.9);
    border-color: oklch(0.464 0.169 26.9);
  }

  @media (max-width: 767px) {
    .needs,
    .lanes {
      grid-auto-flow: row;
      grid-auto-columns: 1fr;
    }
  }
</style>

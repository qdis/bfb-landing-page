---
// ABOUTME: Waitlist form that posts a work email to /api/signup.
// ABOUTME: Label above the field, live status, loading and error states.

import { COPY } from "../lib/copy";

const copy = COPY.signup;
---

<form class="signup" data-signup method="post" action="/api/signup" novalidate>
  <div class="field">
    <label for="email">{copy.label}</label>
    <input
      id="email"
      name="email"
      type="email"
      autocomplete="email"
      inputmode="email"
      required
      spellcheck="false"
    />
    <p class="hint">{copy.hint}</p>
  </div>
  <button type="submit">{copy.cta}</button>
  <p class="status" data-signup-status role="status" aria-live="polite" hidden></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-signup]");
  if (form) {
    const status = form.querySelector<HTMLElement>("[data-signup-status]");
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const input = form.querySelector<HTMLInputElement>("input[name=email]");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!status || !button || !input) {
        return;
      }
      button.disabled = true;
      status.hidden = false;
      status.dataset.state = "pending";
      status.textContent = "Saving your seat.";
      try {
        const response = await fetch("/api/signup", {
          method: "POST",
          headers: {
            "content-type": "application/json",
            accept: "application/json",
          },
          body: JSON.stringify({ email: input.value }),
        });
        const payload = (await response.json()) as {
          ok?: boolean;
          created?: boolean;
          error?: string;
        };
        if (!response.ok || !payload.ok) {
          status.dataset.state = "error";
          status.textContent = payload.error ?? "Could not save that address.";
          return;
        }
        status.dataset.state = "ok";
        status.textContent =
          payload.created === false
            ? "You are already on the list."
            : "You are on the list. We will write when the board opens.";
        form.reset();
      } catch {
        status.dataset.state = "error";
        status.textContent = "Network failed. Try again.";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .signup {
    display: grid;
    gap: 0.9rem;
    width: 100%;
    max-width: 28rem;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--bone);
  }

  input {
    width: 100%;
    min-height: 48px;
    border: 1px solid color-mix(in oklab, var(--bone) 28%, var(--hairline));
    border-radius: var(--signup-radius);
    background: var(--blackout);
    color: var(--signup-ink);
    padding: 0.7rem 0.85rem;
    font-size: 1rem;
  }

  input::placeholder {
    color: color-mix(in oklab, var(--signup-ink) 45%, transparent);
  }

  input:focus-visible {
    outline: 2px solid var(--bone);
    outline-offset: 2px;
    border-color: var(--crimson);
  }

  .hint {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.4;
    color: var(--signup-muted);
  }

  button {
    min-height: 48px;
    width: fit-content;
    border: 0;
    border-radius: var(--signup-radius);
    background: var(--signup-accent);
    color: var(--signup-on-accent);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.78rem;
    cursor: pointer;
    padding: 0.75rem 1.25rem;
    white-space: nowrap;
  }

  button:hover {
    background: var(--safelight);
    color: var(--blackout);
  }

  button:active {
    transform: translateY(1px);
  }

  button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .status {
    margin: 0;
    min-height: 1.4em;
    font-size: 0.95rem;
  }

  .status[data-state="error"] {
    color: var(--signup-error);
  }

  .status[data-state="ok"] {
    color: var(--signup-ok);
  }
</style>

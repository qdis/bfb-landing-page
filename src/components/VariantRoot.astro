---
// ABOUTME: Picks the visual shell for a variant slug while sharing one copy object.
// ABOUTME: Keeps claim text in src/lib/copy.ts so variants cannot drift.

import { COPY, type Variant } from "../lib/copy";
import Chapter from "../variants/Chapter.astro";
import Dispatch from "../variants/Dispatch.astro";
import Grid from "../variants/Grid.astro";
import Obit from "../variants/Obit.astro";
import Split from "../variants/Split.astro";
import Stencil from "../variants/Stencil.astro";
import Tape from "../variants/Tape.astro";

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;
const copy = COPY;
void copy;
---

{
  variant.slug === "obit" && <Obit variant={variant} />
}
{
  variant.slug === "dispatch" && <Dispatch variant={variant} />
}
{
  variant.slug === "stencil" && <Stencil variant={variant} />
}
{
  variant.slug === "split" && <Split variant={variant} />
}
{
  variant.slug === "tape" && <Tape variant={variant} />
}
{
  variant.slug === "grid" && <Grid variant={variant} />
}
{
  variant.slug === "chapter" && <Chapter variant={variant} />
}

---
// ABOUTME: Compact links between the five visual variants of the landing.
// ABOUTME: The current variant is marked so the switcher stays scannable.

import { COPY, VARIANTS, type Variant } from "../lib/copy";

interface Props {
  current: Variant;
}

const { current } = Astro.props;
---

<nav class="switch" aria-label="Landing variants">
  <a href="/">{COPY.shortName}</a>
  <ul>
    {
      VARIANTS.map((variant) => (
        <li>
          <a href={variant.path} aria-current={variant.slug === current.slug ? "page" : undefined}>
            {variant.title}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .switch {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    text-decoration: none;
  }

  a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>

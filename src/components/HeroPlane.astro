---
// ABOUTME: Live sample board. Agents work, hand off, and raise human gates.
// ABOUTME: State is simulated in the browser. Not a looping CSS costume.

import { COPY } from "../lib/copy";
import Icon from "./Icon.astro";
---

<div class="plane" data-board role="region" aria-label={COPY.plane.label}>
  <div class="strip">
    <span class="live">Live</span>
    <span><b data-stat-agents>4</b> agents</span>
    <span><b data-stat-need>1</b> need you</span>
    <span><b data-stat-handoff>1</b> handoff</span>
  </div>

  <div class="row attention" data-attention-row>
    <div class="rail">
      <span class="octagon">
        <Icon name="HandPalm" size={22} />
      </span>
      <span class="rail-label">Attention</span>
    </div>
    <div class="body">
      <Icon name="User" size={22} />
      <div class="copy">
        <p class="need">Human needed</p>
        <p class="title" data-attention-title>Approve runner wake on Timo's Mac Studio</p>
        <p class="mono" data-attention-why>You own this runner</p>
      </div>
      <button class="start" type="button" data-clear-attention>Start</button>
    </div>
  </div>

  {
    [0, 1, 2].map((index) => (
      <div class="row working">
        <div class="rail">
          <Icon name="ArrowsClockwise" size={22} />
          <span class="rail-label" data-lane-provider={`${index}`}>
            {index === 0 ? "Claude" : index === 1 ? "Codex" : "Grok"}
          </span>
        </div>
        <div class="body">
          <Icon name="GearSix" size={20} />
          <div class="copy">
            <p class="state">
              <span data-lane-activity={`${index}`}>working</span>
              <span class="clock" data-lane-clock={`${index}`}>04:07</span>
            </p>
            <p class="title" data-lane-title={`${index}`}>
              {index === 0
                ? "Replay live events after reconnect"
                : index === 1
                  ? "Run checkout lease tests"
                  : "Draft reconnect plan"}
            </p>
            <p class="mono" data-lane-checkout={`${index}`}>
              bfb / Mac Studio / main@76ab1f9
            </p>
          </div>
          <span class="spinner" aria-hidden="true"></span>
        </div>
      </div>
    ))
  }

  <div class="row handoff" data-handoff-row>
    <div class="rail">
      <Icon name="ArrowsClockwise" size={22} />
      <span class="rail-label">Handoff</span>
    </div>
    <div class="body">
      <div class="copy">
        <p class="need" data-handoff-line>Claude passed this to Codex</p>
        <p class="title" data-handoff-title>Compare review policy across providers</p>
      </div>
    </div>
  </div>

  <div class="row committed">
    <div class="rail">
      <Icon name="ShieldCheck" size={28} />
      <span class="rail-label">Delivered</span>
      <span class="rail-meta" data-delivered-ago>20m ago</span>
    </div>
    <div class="body">
      <Icon name="User" size={20} />
      <div class="copy">
        <p class="state">Accepted</p>
        <p class="title" data-delivered-title>Timo accepted artifact v3</p>
      </div>
    </div>
  </div>

  <div class="row launch">
    <div class="rail">
      <Icon name="RocketLaunch" size={22} />
      <span class="rail-label">Start a session</span>
    </div>
    <div class="body launch-body">
      <div class="providers">
        <button class="provider on" type="button" data-start-provider="Claude">
          <span class="ai">AI</span>
          Claude
        </button>
        <button class="provider" type="button" data-start-provider="Codex">
          <Icon name="Cube" size={16} />
          Codex
        </button>
        <button class="provider" type="button" data-start-provider="Grok">
          <Icon name="Crosshair" size={16} />
          Grok
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { mountBoard } from "../lib/board-sim";

  const root = document.querySelector("[data-board]");
  if (root instanceof HTMLElement) {
    const stop = mountBoard(root);
    window.addEventListener("pagehide", stop, { once: true });
  }
</script>

<style>
  .plane {
    display: grid;
    width: min(100%, 50rem);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-panel);
    background: var(--chamber);
    overflow: hidden;
  }

  .strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.1rem;
    padding: 0.7rem 0.95rem;
    border-bottom: 1px solid var(--hairline);
    color: var(--smoke);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .strip b {
    color: var(--bone);
    font-weight: 600;
  }

  .live {
    color: var(--safelight);
  }

  .row {
    display: grid;
    grid-template-columns: 8.2rem 1fr;
    border-bottom: 1px solid var(--hairline);
  }

  .row:last-child {
    border-bottom: 0;
  }

  .rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.75rem 0.5rem;
    border-right: 1px solid var(--hairline);
    color: var(--smoke);
    text-align: center;
  }

  .rail-label,
  .rail-meta,
  .need,
  .state,
  .fact-k {
    margin: 0;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .body {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 0.9rem;
    min-width: 0;
  }

  .copy {
    min-width: 0;
    flex: 1;
  }

  .title {
    margin: 0.12rem 0 0;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--bone);
  }

  .mono,
  .clock {
    margin: 0.15rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: var(--smoke);
  }

  .state {
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
  }

  .octagon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    color: var(--crimson);
    background: color-mix(in oklab, var(--crimson) 18%, var(--chamber));
    clip-path: polygon(30% 0, 70% 0, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0 70%, 0 30%);
  }

  .attention .body {
    background: color-mix(in oklab, var(--crimson) 24%, var(--chamber));
  }

  .need {
    color: var(--safelight);
  }

  .start,
  .provider {
    font: inherit;
    cursor: pointer;
    background: transparent;
  }

  .start {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    height: 2.05rem;
    padding: 0 0.85rem;
    border: 1px solid var(--crimson);
    border-radius: var(--radius-control);
    color: var(--crimson);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .start:hover,
  .provider:hover {
    background: var(--raised);
    color: var(--bone);
  }

  .start:active,
  .provider:active {
    transform: translateY(1px);
  }

  .spinner {
    margin-left: auto;
    width: 1.45rem;
    height: 1.45rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      transparent 0 12%,
      var(--smoke) 0 16%,
      transparent 0 29%,
      var(--smoke) 0 33%,
      transparent 0 46%,
      var(--smoke) 0 50%,
      transparent 0 63%,
      var(--smoke) 0 67%,
      transparent 0 80%,
      var(--smoke) 0 84%,
      transparent 0 97%,
      var(--smoke) 0 100%
    );
    -webkit-mask: radial-gradient(farthest-side, transparent 58%, #000 59%);
    mask: radial-gradient(farthest-side, transparent 58%, #000 59%);
  }

  .providers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.4rem;
    flex: 1;
    min-width: 0;
  }

  .provider {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    height: 2.25rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-control);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--smoke);
  }

  .provider.on {
    color: var(--bone);
    border-color: color-mix(in oklab, var(--bone) 35%, var(--hairline));
    background: var(--raised);
  }

  .ai {
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 0.46rem;
    letter-spacing: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .spinner {
      animation: spin 1.25s linear infinite;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 700px) {
    .row {
      grid-template-columns: 1fr;
    }

    .rail {
      flex-direction: row;
      justify-content: flex-start;
      border-right: 0;
      border-bottom: 1px solid var(--hairline);
      padding: 0.55rem 0.8rem;
    }

    .providers {
      grid-template-columns: 1fr;
    }
  }
</style>

---
// ABOUTME: Sample operational plane matching the official Redline mockup.
// ABOUTME: Demonstration chrome only; marketing actions stay on Get BFB.

import { COPY } from "../lib/copy";
import Icon from "./Icon.astro";
---

<div class="plane" role="img" aria-label={COPY.plane.label}>
  <div class="row attention">
    <div class="rail">
      <span class="octagon">
        <Icon name="HandPalm" size={22} />
      </span>
      <span class="rail-label">Attention</span>
    </div>
    <div class="body">
      <Icon name="User" size={22} />
      <div class="copy">
        <p class="need">Human needed</p>
        <p class="title">Approve runner wake on Timo's Mac Studio</p>
      </div>
      <span class="start">Start</span>
    </div>
  </div>

  <div class="row working">
    <div class="rail">
      <Icon name="ArrowsClockwise" size={26} />
      <span class="rail-label">Claude Code</span>
    </div>
    <div class="body">
      <Icon name="GearSix" size={22} />
      <div class="copy">
        <p class="state">Working</p>
        <p class="title">Replay live events after reconnect</p>
        <p class="mono">bfb / Mac Studio / main@76ab1f9</p>
      </div>
      <span class="spinner" aria-hidden="true"></span>
    </div>
  </div>

  <div class="row committed">
    <div class="rail">
      <Icon name="ShieldCheck" size={34} />
      <span class="rail-label">Activity committed</span>
      <span class="rail-meta">12 sec ago</span>
    </div>
    <div class="body stacked">
      <div class="review">
        <Icon name="User" size={20} />
        <div>
          <p class="state">Timo reviewed artifact v3</p>
          <p class="mono">20 min ago</p>
        </div>
      </div>
      <div class="facts">
        <div class="fact">
          <Icon name="FileCode" size={18} />
          <div>
            <p class="fact-k">Changeset</p>
            <p class="mono">main@76ab1f9</p>
          </div>
        </div>
        <div class="fact">
          <p class="fact-k">Commit</p>
          <p class="mono">76ab1f9342c8d8e2</p>
        </div>
        <div class="fact">
          <Icon name="Database" size={18} />
          <div>
            <p class="fact-k">Evidence</p>
            <p class="mono">build, tests, logs</p>
          </div>
        </div>
        <div class="fact">
          <p class="fact-k">Duration</p>
          <p class="mono">02:47</p>
        </div>
      </div>
    </div>
  </div>

  <div class="row launch">
    <div class="rail">
      <Icon name="RocketLaunch" size={26} />
      <span class="rail-label">Start a session</span>
    </div>
    <div class="body launch-body">
      <div class="providers">
        <span class="provider on">
          <span class="ai">AI</span>
          Claude
        </span>
        <span class="provider">
          <Icon name="Cube" size={16} />
          Codex
        </span>
        <span class="provider">
          <Icon name="Crosshair" size={16} />
          Grok
        </span>
      </div>
      <span class="start">Start</span>
    </div>
  </div>
</div>

<style>
  .plane {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    width: min(100%, 48rem);
    min-height: 28rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-panel);
    background: var(--chamber);
    overflow: hidden;
  }

  .row {
    display: grid;
    grid-template-columns: 8.6rem 1fr;
    border-bottom: 1px solid var(--hairline);
  }

  .row:last-child {
    border-bottom: 0;
  }

  .rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.9rem 0.6rem;
    border-right: 1px solid var(--hairline);
    color: var(--smoke);
    text-align: center;
  }

  .rail-label,
  .rail-meta,
  .need,
  .state,
  .fact-k {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rail-meta {
    color: var(--smoke);
    letter-spacing: 0.06em;
  }

  .body {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1rem;
    min-width: 0;
  }

  .copy,
  .review > div,
  .fact > div {
    min-width: 0;
  }

  .title {
    margin: 0.15rem 0 0;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--bone);
  }

  .mono {
    margin: 0.2rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: var(--smoke);
  }

  .octagon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    color: var(--crimson);
    background: color-mix(in oklab, var(--crimson) 16%, var(--chamber));
    clip-path: polygon(30% 0, 70% 0, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0 70%, 0 30%);
  }

  .attention .body {
    background: color-mix(in oklab, var(--crimson) 28%, var(--chamber));
  }

  .need {
    color: var(--safelight);
  }

  .start {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    height: 2.1rem;
    padding: 0 0.9rem;
    border: 1px solid var(--crimson);
    border-radius: var(--radius-control);
    color: var(--crimson);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .spinner {
    margin-left: auto;
    width: 1.7rem;
    height: 1.7rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      transparent 0 12%,
      var(--smoke) 0 16%,
      transparent 0 29%,
      var(--smoke) 0 33%,
      transparent 0 46%,
      var(--smoke) 0 50%,
      transparent 0 63%,
      var(--smoke) 0 67%,
      transparent 0 80%,
      var(--smoke) 0 84%,
      transparent 0 97%,
      var(--smoke) 0 100%
    );
    -webkit-mask: radial-gradient(farthest-side, transparent 58%, #000 59%);
    mask: radial-gradient(farthest-side, transparent 58%, #000 59%);
  }

  .stacked {
    display: block;
    padding: 0.85rem 1rem 1rem;
  }

  .review {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding-bottom: 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--hairline);
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.65rem 1.5rem;
  }

  .fact {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .launch-body {
    gap: 0.75rem;
  }

  .providers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.4rem;
    flex: 1;
    min-width: 0;
  }

  .provider {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    height: 2.35rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-control);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--smoke);
  }

  .provider.on {
    color: var(--bone);
    border-color: color-mix(in oklab, var(--bone) 35%, var(--hairline));
    background: var(--raised);
  }

  .ai {
    display: grid;
    place-items: center;
    width: 1.2rem;
    height: 1.2rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 0.48rem;
    letter-spacing: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .spinner {
      animation: spin 1.25s linear infinite;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 640px) {
    .plane {
      min-height: 0;
    }

    .row {
      grid-template-columns: 1fr;
    }

    .rail {
      flex-direction: row;
      justify-content: flex-start;
      border-right: 0;
      border-bottom: 1px solid var(--hairline);
      padding: 0.65rem 0.85rem;
    }

    .facts {
      grid-template-columns: 1fr;
    }

    .providers {
      grid-template-columns: 1fr;
    }
  }
</style>

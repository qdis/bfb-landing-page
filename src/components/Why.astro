---
// ABOUTME: Value proposition as two ledgers: what BFB is not, why you need it.
// ABOUTME: The keyboard table sits with the "not" copy. The need list stays type.

import { COPY } from "../lib/copy";
---

<section class="why" id="how">
  <div class="slab not">
    <div class="wrap pair">
      <figure>
        <img
          src="/images/keyboard-table.jpg"
          alt="A conference table that is a giant keyboard, USB cable coiled around a mug."
          width="1600"
          height="900"
        />
      </figure>
      <div class="copy">
        <h2>{COPY.why.notHeadline}</h2>
        <dl>
          {
            COPY.why.nots.map((item) => (
              <div>
                <dt>{item.title}</dt>
                <dd>{item.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
  <div class="slab need">
    <div class="wrap">
      <h2>{COPY.why.needHeadline}</h2>
      <ul>
        {
          COPY.why.needs.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .why {
    background: var(--blackout);
  }

  .slab {
    padding: 4.5rem 0 5rem;
  }

  .not {
    background: var(--chamber);
    border-top: 1px solid var(--hairline);
  }

  .need {
    background: var(--blackout);
    border-top: 1px solid var(--hairline);
  }

  .pair {
    display: grid;
    gap: 1.6rem;
  }

  figure {
    margin: 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    filter: saturate(1.12) contrast(1.06);
  }

  h2 {
    margin: 0 0 1.6rem;
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.045em;
  }

  dl,
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  dl > div {
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--hairline);
  }

  dt {
    color: var(--smoke);
    font-size: 1.02rem;
    font-weight: 500;
    text-decoration: line-through;
    text-decoration-color: color-mix(in oklab, var(--crimson) 70%, var(--smoke));
    text-decoration-thickness: 2px;
  }

  dd {
    margin: 0;
    max-width: 46ch;
    color: var(--bone);
    font-size: 1.08rem;
    line-height: 1.45;
  }

  ul li {
    padding: 1.2rem 0 1.3rem;
    border-top: 1px solid var(--hairline);
  }

  h3 {
    margin: 0 0 0.4rem;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  p {
    margin: 0;
    max-width: 58ch;
    color: var(--smoke);
    font-size: 1.05rem;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .slab {
      padding: 6rem 0 6.2rem;
    }

    .pair {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      gap: 3.5rem 4rem;
      align-items: start;
    }

    .pair figure {
      position: sticky;
      top: calc(var(--nav-h) + 1.4rem);
    }

    .pair img {
      aspect-ratio: 4 / 5;
    }

    dl > div {
      grid-template-columns: minmax(11rem, 0.4fr) minmax(0, 1fr);
      gap: 1.4rem;
      align-items: baseline;
    }
  }
</style>

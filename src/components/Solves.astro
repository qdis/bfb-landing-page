---
// ABOUTME: Names the dead ticket machines against a safelight still.
// ABOUTME: Type on the left, photograph on the right, one theme.

import { COPY } from "../lib/copy";

const { headline, jira, body, punch, names } = COPY.solves;
---

<section class="solves" id="solves">
  <div class="copy">
    <h2>{headline}</h2>
    <p class="dead">{jira}</p>
    <p>{body}</p>
    <p class="punch">{punch}</p>
    <ul>
      {
        names.map((name) => (
          <li>
            <s>{name}</s>
          </li>
        ))
      }
    </ul>
  </div>
  <figure>
    <img
      src="/images/safelight-desk.jpg"
      alt="Empty night operations desk under a single red safelight"
      width="1536"
      height="864"
    />
  </figure>
</section>

<style>
  .solves {
    display: grid;
    background: var(--chamber);
    border-top: 1px solid var(--hairline);
  }

  .copy {
    padding: 4rem 1.25rem 3rem;
  }

  h2 {
    margin: 0 0 1.2rem;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 3.1rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .dead {
    margin: 0 0 1rem;
    color: var(--safelight);
    font-weight: 600;
  }

  p {
    margin: 0;
    max-width: 54ch;
    color: var(--smoke);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .punch {
    margin-top: 1.1rem;
    color: var(--bone);
    font-weight: 500;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  s {
    color: var(--smoke);
    text-decoration-color: var(--crimson);
    text-decoration-thickness: 1.5px;
    font-size: 0.95rem;
    font-weight: 500;
  }

  figure {
    margin: 0;
    min-height: 16rem;
    background: var(--oxblood-deep);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 16rem;
  }

  @media (min-width: 768px) {
    .copy {
      padding: 5.5rem 2rem 4.5rem;
    }
  }

  @media (min-width: 1024px) {
    .solves {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      min-height: 36rem;
    }

    .copy {
      padding: 5.5rem 3rem 5rem 2.25rem;
    }

    figure,
    img {
      min-height: 100%;
    }
  }
</style>

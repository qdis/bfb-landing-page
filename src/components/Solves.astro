---
// ABOUTME: Type attack on ticket ceremony. Giant struck names, uneven, crimson.
// ABOUTME: The graveyard is the section. The photo sits as a stain, not a split.

import { COPY } from "../lib/copy";

const { jira, body, punch, names } = COPY.solves;

const tilt = [-3.2, 2.1, -1.4, 3.6, -2.6, 1.2, -4.1, 2.8, -1.8, 3.1, -2.2, 1.6, 0.8];
---

<section class="solves" id="solves">
  <div class="stain" aria-hidden="true"></div>
  <div class="wrap">
    <h2>
      <span class="kill a"><s>JIRA</s></span>
      <span class="is-dead">IS DEAD.</span>
      <span class="kill b"><s>SCRUM</s></span>
      <span class="is-dead">IS DEAD.</span>
    </h2>
    <p class="law">{jira}</p>
    <p class="attack">{body}</p>
    <ul class="grave">
      {
        names.map((name, index) => (
          <li style={`--rot: ${tilt[index] ?? 0}deg`}>
            <s>{name}</s>
          </li>
        ))
      }
    </ul>
    <p class="punch">{punch}</p>
    <img
      class="chair"
      src="/images/chair-outlet.jpg"
      alt="An office chair with a wall outlet growing from the seat and a neon cord on the floor."
      width="1200"
      height="900"
    />
  </div>
</section>

<style>
  .solves {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 4.5rem 0 5rem;
    background: var(--oxblood-deep);
    border-top: 1px solid color-mix(in oklab, var(--crimson) 45%, var(--hairline));
  }

  .stain {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(
        oklch(0.08 0.04 26 / 0.78),
        oklch(0.07 0.03 26 / 0.88)
      ),
      url("/images/chair-outlet.jpg") center / cover no-repeat;
    filter: saturate(1.25) contrast(1.1);
  }

  .wrap {
    position: relative;
    z-index: 1;
  }

  h2 {
    margin: 0;
    display: grid;
    justify-items: start;
  }

  .kill {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(4.4rem, 18vw, 11.5rem);
    font-weight: 800;
    line-height: 0.78;
    letter-spacing: -0.055em;
    color: var(--bone);
  }

  .kill s {
    text-decoration: none;
    background-image:
      linear-gradient(
        178deg,
        transparent 38%,
        color-mix(in oklab, var(--crimson) 88%, black) 40%,
        var(--crimson) 52%,
        color-mix(in oklab, var(--crimson) 70%, black) 58%,
        transparent 62%
      ),
      linear-gradient(
        4deg,
        transparent 46%,
        color-mix(in oklab, var(--crimson) 55%, transparent) 48%,
        transparent 54%
      );
    background-repeat: no-repeat;
    padding: 0 0.04em;
  }

  .kill.a {
    transform: rotate(-1.8deg);
  }

  .kill.b {
    transform: rotate(1.4deg);
    margin-left: 6%;
  }

  .is-dead {
    display: block;
    margin: 0.15em 0 0.35em;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4.2vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--safelight);
  }

  .law,
  .attack,
  .punch {
    margin: 0;
    max-width: 46rem;
  }

  .law {
    margin-top: 2rem;
    color: var(--safelight);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .attack {
    margin-top: 0.85rem;
    color: var(--bone);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.45;
  }

  .grave {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem 1.35rem;
    margin: 2.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .grave li {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 4.2vw, 3.4rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
    transform: rotate(var(--rot));
  }

  .grave li:nth-child(1),
  .grave li:nth-child(2),
  .grave li:nth-child(5) {
    font-size: clamp(2.1rem, 6vw, 4.6rem);
  }

  .grave s {
    color: color-mix(in oklab, var(--bone) 72%, var(--crimson));
    text-decoration-line: line-through;
    text-decoration-color: var(--crimson);
    text-decoration-thickness: 0.16em;
    text-decoration-skip-ink: none;
    text-underline-offset: -0.12em;
  }

  .punch {
    margin-top: 2rem;
    color: var(--bone);
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .chair {
    display: block;
    width: min(100%, 28rem);
    margin: 2.2rem 0 0;
    border: 1px solid color-mix(in oklab, var(--crimson) 40%, var(--hairline));
    box-shadow: var(--neon-glow);
  }

  @media (min-width: 768px) {
    .solves {
      padding: 6rem 0 6.5rem;
    }
  }
</style>

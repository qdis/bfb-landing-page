---
// ABOUTME: Named ticket machines the landing treats as the dead category.
// ABOUTME: Keeps Jira plus Linear, Asana, Monday, and the rest in one list.

import { COPY } from "../lib/copy";
---

<section class="rivals" aria-label="Ticket machines">
  <p class="rivals-line">{COPY.rivals.line}</p>
  <ul>
    {
      COPY.rivals.names.map((name) => (
        <li>{name}</li>
      ))
    }
  </ul>
</section>

<style>
  .rivals {
    display: grid;
    gap: 0.7rem;
  }

  .rivals-line {
    margin: 0;
    max-width: 62ch;
    line-height: 1.4;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.85rem;
  }

  li {
    margin: 0;
  }
</style>

---
// ABOUTME: Single-line masthead for the waitlist landing.
// ABOUTME: In-page jumps only. Signup lives in the hero and the close.

import { COPY } from "../lib/copy";

const { nav, comingSoon, shortName } = COPY;
---

<header class="mast">
  <div class="wrap bar">
    <a class="brand" href="#top">{shortName}</a>
    <p class="soon">{comingSoon}</p>
    <nav class="links" aria-label="Page">
      <a href="#demo">Demo</a>
      <a href="#product">{nav.product}</a>
      <a href="#how">{nav.how}</a>
    </nav>
  </div>
</header>

<style>
  .mast {
    position: sticky;
    top: 0;
    z-index: 10;
    height: var(--nav-h);
    background: var(--blackout);
    border-bottom: 1px solid var(--hairline);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: var(--nav-h);
  }

  .brand {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .soon {
    margin: 0;
    color: var(--smoke);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .links {
    display: none;
    gap: 1.5rem;
    margin-left: auto;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .links a:hover {
    color: var(--safelight);
  }

  @media (min-width: 768px) {
    .links {
      display: flex;
    }
  }
</style>

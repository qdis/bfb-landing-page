---
// ABOUTME: Waitlist close. Coming soon plus the only signup form on the page.
// ABOUTME: Same Get BFB label as the masthead and hero.

import { COPY } from "../lib/copy";
import SignupForm from "./SignupForm.astro";
---

<section class="close" id="signup">
  <div class="inner">
    <h2>{COPY.close.headline}</h2>
    <p>{COPY.close.body}</p>
    <SignupForm />
  </div>
</section>

<style>
  .close {
    background: var(--oxblood);
    border-top: 1px solid var(--hairline);
  }

  .inner {
    max-width: 36rem;
    padding: 5rem 1.25rem 5.5rem;
  }

  h2 {
    margin: 0 0 0.85rem;
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.6vw, 3.6rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  p {
    margin: 0 0 1.6rem;
    max-width: 40ch;
    color: color-mix(in oklab, var(--bone) 80%, var(--smoke));
    font-size: 1.05rem;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .inner {
      padding: 6.5rem 2rem 7rem;
    }
  }
</style>

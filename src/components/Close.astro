---
// ABOUTME: Waitlist close. Neon headline plus the same loud signup as the hero.
// ABOUTME: No masthead CTA. This is the last in-your-face control.

import { COPY } from "../lib/copy";
import SignupForm from "./SignupForm.astro";
---

<section class="close" id="signup">
  <div class="wrap inner">
    <h2>{COPY.close.headline}</h2>
    <p>{COPY.close.body}</p>
    <SignupForm loud fieldId="close-email" cta={COPY.close.cta} />
  </div>
</section>

<style>
  .close {
    background: var(--oxblood);
    border-top: 1px solid color-mix(in oklab, var(--crimson) 35%, var(--hairline));
  }

  .close :global(.loud button) {
    box-shadow: 0 0 0.7rem color-mix(in oklab, var(--crimson) 65%, transparent);
  }

  .inner {
    max-width: 40rem;
    padding: 5rem 0 5.5rem;
    margin-left: auto;
    margin-right: auto;
  }

  h2 {
    margin: 0 0 0.85rem;
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.6vw, 4.2rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.045em;
    color: var(--safelight);
    text-shadow: 0 0 0.55em color-mix(in oklab, var(--crimson) 55%, transparent);
  }

  p {
    margin: 0 0 1.8rem;
    max-width: 40ch;
    color: color-mix(in oklab, var(--bone) 80%, var(--smoke));
    font-size: 1.05rem;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .inner {
      padding: 7rem 0 7.4rem;
    }
  }
</style>

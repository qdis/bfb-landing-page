---
// ABOUTME: Shared feature list drawn from the BFB architecture highlights.
// ABOUTME: Variants restyle the list. The words stay in src/lib/copy.ts.

import { COPY } from "../lib/copy";
---

<section class="features" aria-label="What the board does">
  <p class="features-kicker">{COPY.scale}</p>
  <ul>
    {
      COPY.features.map((feature) => (
        <li>
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </li>
      ))
    }
  </ul>
  <p class="features-bound">{COPY.boundary}</p>
</section>

<style>
  .features {
    display: grid;
    gap: 1rem;
  }

  .features-kicker,
  .features-bound {
    margin: 0;
    max-width: 68ch;
    line-height: 1.4;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  h3 {
    margin: 0 0 0.2rem;
    font-size: 1rem;
  }

  li p {
    margin: 0;
    max-width: 58ch;
    line-height: 1.4;
  }
</style>

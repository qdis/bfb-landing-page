---
// ABOUTME: What BFB is. Type on the left, melting tickets as the object.
// ABOUTME: Same facts as before. The still sits with the copy, not under it.

import { COPY } from "../lib/copy";

const { headline, lead, body } = COPY.what;
---

<section class="product" id="product">
  <div class="wrap stage">
    <div class="copy">
      <h2>{headline}</h2>
      <p class="lead">{lead}</p>
      <p>{body}</p>
    </div>
    <figure>
      <img
        src="/images/ticket-melt.jpg"
        alt="Blank tickets melting into a surge protector under neon red light."
        width="1200"
        height="800"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
  .product {
    padding: 5rem 0 0;
    background: var(--blackout);
    border-top: 1px solid var(--hairline);
  }

  .stage {
    display: grid;
    gap: 1.6rem;
  }

  h2 {
    margin: 0 0 1.2rem;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.045em;
  }

  p {
    margin: 0 0 1rem;
    max-width: 38ch;
    font-size: 1.06rem;
    line-height: 1.5;
    color: var(--smoke);
  }

  .lead {
    color: var(--bone);
    font-weight: 500;
    max-width: 42ch;
  }

  figure {
    margin: 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 30%;
    filter: saturate(1.12) contrast(1.06);
  }

  @media (min-width: 768px) {
    .product {
      padding: 6.5rem 0 0;
    }

    .stage {
      grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.85fr);
      gap: 3.5rem 4rem;
      align-items: end;
    }

    .copy {
      padding-bottom: 3.5rem;
    }

    img {
      aspect-ratio: 3 / 4;
    }
  }
</style>

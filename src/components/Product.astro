---
// ABOUTME: What BFB is, offset from the hero. Full-width line, two text columns.
// ABOUTME: Same facts, different presentation: no live board, no death poster.

import { COPY } from "../lib/copy";

const { headline, lead, body } = COPY.what;
---

<section class="product" id="product">
  <div class="wrap">
    <h2>{headline}</h2>
    <div class="cols">
      <p class="lead">{lead}</p>
      <p>{body}</p>
      <img
        src="/images/ticket-melt.jpg"
        alt="Blank tickets melting into a surge protector under neon red light."
        width="1200"
        height="800"
      />
    </div>
  </div>
</section>

<style>
  .product {
    padding: 5.5rem 0 5rem;
    background: var(--blackout);
    border-top: 1px solid var(--hairline);
  }

  h2 {
    margin: 0 0 2.2rem;
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 5vw, 4.2rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.045em;
  }

  .cols {
    display: grid;
    gap: 1.4rem;
  }

  p {
    margin: 0;
    max-width: 58ch;
    font-size: 1.06rem;
    line-height: 1.55;
    color: var(--smoke);
  }

  .lead {
    color: var(--bone);
    font-weight: 500;
  }

  img {
    width: 100%;
    max-width: 28rem;
    margin-top: 0.4rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-panel);
    filter: saturate(1.15) contrast(1.08);
  }

  @media (min-width: 768px) {
    .product {
      padding: 7.5rem 0 6.5rem;
    }

    .cols {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 3rem;
      align-items: start;
    }

    img {
      grid-column: 1 / -1;
      width: min(100%, 36rem);
      justify-self: end;
      margin-top: 0.5rem;
    }
  }
</style>

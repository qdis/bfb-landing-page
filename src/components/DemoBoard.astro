---
// ABOUTME: Clickable BFB demo board that plays a scripted product story.
// ABOUTME: Claude asks Timo, Timo answers live, Codex takes the review, Adina ships.

import Icon from "./Icon.astro";
import {
  BEATS,
  INSPECT,
  PROJECTS,
  QUESTION,
  boardSpend,
  formatClock,
  snapshot,
} from "../lib/demo-script";

const seedSpend = boardSpend(seed.cards);

const seed = snapshot(0, "runner");
---

<div class="demo" data-demo>
  <div class="toolbar">
    <button class="live on" type="button" data-live aria-pressed="true">Live</button>
    <button class="ghost space" type="button" data-space>workspace <b>bfb</b></button>
    <div class="crew" data-crew>
      {
        ["Timo", "Adina", "Claude", "Codex", "Grok"].map((actor) => (
          <button type="button" data-actor={actor}>
            <i data-dot={actor} aria-hidden="true"></i>
            {actor}
            <span data-mode={actor}>idle</span>
          </button>
        ))
      }
    </div>
    <button class="stat" type="button" data-need-btn>
      <b data-need>0</b> need a human
    </button>
    <span class="spend-board mono" data-spend title="Human attention versus agent time on this board">
      <span>human <b data-spend-you>{formatClock(seedSpend.human)}</b></span>
      <span>agent <b data-spend-agents>{formatClock(seedSpend.agent)}</b></span>
    </span>
    <span class="mono ping" data-ping>24ms</span>
    <span class="mono sess" data-session>00:00</span>
    <button class="ghost" type="button" data-replay>Replay</button>
  </div>

  <button class="attention" type="button" data-attention hidden>
    <span class="octagon" aria-hidden="true">
      <Icon name="HandPalm" size={18} />
    </span>
    <span class="att-rail">
      <span class="att-k" data-att-k>Human needed</span>
      <span class="att-who" data-att-who>Claude to Timo · A01</span>
    </span>
    <span class="att-body">
      <span class="att-title" data-att-title></span>
      <span class="att-why" data-att-why></span>
    </span>
    <span class="att-go" data-att-go>Answer</span>
  </button>

  <ol class="beats">
    {
      BEATS.map((beat, index) => (
        <li>
          <button type="button" data-beat={String(index)} class:list={[{ on: index === 0 }]}>
            {beat.label}
          </button>
        </li>
      ))
    }
  </ol>

  <div class="stage">
    <div class="lanes">
      {
        PROJECTS.map((project) => (
          <section>
            <h3>{project}</h3>
            <ul>
              {seed.cards
                .filter((item) => item.project === project)
                .map((item) => (
                  <li>
                    <button
                      class:list={["card", { on: item.id === "a01", wait: item.id === "e02" }]}
                      type="button"
                      data-card={item.id}
                      hidden={item.id === "wake"}
                    >
                      <span class="row">
                        <span class="who">
                          <span data-owner={item.id}>{item.owner}</span>
                          <span class="pack">{item.pack}</span>
                        </span>
                        <span class="run">
                          <span class="act" data-act={item.id}>{item.activity}</span>
                          <span class="spinner" data-spin={item.id} hidden={item.activity !== "working" && item.activity !== "reviewing"} aria-hidden="true"></span>
                        </span>
                      </span>
                      <span class="title">{item.title}</span>
                      <span class="now">{item.now}</span>
                      <span class="pass" data-pass={item.id} hidden></span>
                      <span class="meta">
                        <span class="hashline" data-out={item.id}>{item.checkout}</span>
                        <span class="spend">
                          <span>human <b data-you={item.id}>{formatClock(item.humanSeconds)}</b></span>
                          <span>agent <b data-bot={item.id}>{formatClock(item.agentSeconds)}</b></span>
                        </span>
                      </span>
                    </button>
                  </li>
                ))}
            </ul>
          </section>
        ))
      }
    </div>

    <aside class="inspect" data-inspect aria-live="polite">
      <div class="thread">
        <p class="k" data-k>Inspect</p>
        <p class="route" data-route hidden>Claude to Timo · request_human</p>
        <p class="ask" data-question hidden>{QUESTION}</p>
        <p class="wait" data-typing hidden>Timo is answering.</p>
        <p class="said" data-answer hidden></p>
        <div class="acts" data-answers hidden>
          <button type="button" data-say="safe">Send Timo's answer</button>
          <button type="button" data-say="wrong">Give it the full CLI</button>
          <button class="quiet" type="button" data-say="shell">Approve shell</button>
        </div>
      </div>
      <div class="facts">
        <p class="k">Checkout</p>
        <button class="hash" type="button" data-hash>bfb / Mac Studio / main@76ab1f9</button>
        <p class="blurb" data-blurb>{INSPECT.a01}</p>
        <p class="spend-read mono" data-card-spend>
          human {formatClock(seed.cards[0]?.humanSeconds ?? 0)} · agent {formatClock(seed.cards[0]?.agentSeconds ?? 0)}
        </p>
        <ol class="log" data-log></ol>
      </div>
    </aside>
  </div>

  <p class="hint" data-toast>
    Click a card. The script keeps moving unless you pause Live.
  </p>
</div>

<script>
  import {
    BEATS,
    BEAT_HINTS,
    INSPECT,
    TIMO_ANSWER,
    attention,
    boardSpend,
    dwellFor,
    formatClock,
    labelActivity,
    nextBeat,
    presence,
    snapshot,
    tickWorkingCard,
    type DemoState,
  } from "../lib/demo-script";

  const root = document.querySelector("[data-demo]");
  if (root instanceof HTMLElement) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let beat = 0;
    let egg: DemoState["egg"] = "none";
    let state = snapshot(0);
    let paused = false;
    let visible = false;
    let timer = 0;
    let typeTimer = 0;
    let typed = "";
    let adinaHits = 0;
    let timoHits = 0;
    let keys = "";
    let focusActor = "";
    let session = 0;
    const konami = "ArrowUpArrowUpArrowDownArrowDownArrowLeftArrowRightArrowLeftArrowRightba";

    const toast = (text: string) => {
      const node = root.querySelector("[data-toast]");
      if (node) {
        node.textContent = text;
      }
    };

    const paint = () => {
      root.querySelectorAll("[data-beat]").forEach((node) => {
        if (node instanceof HTMLElement) {
          node.classList.toggle("on", Number(node.dataset.beat) === beat);
        }
      });

      root.querySelectorAll("[data-card]").forEach((node) => {
        if (!(node instanceof HTMLElement)) {
          return;
        }
        const id = node.dataset.card ?? "";
        const card = state.cards.find((item) => item.id === id);
        node.hidden = !card;
        if (!card) {
          return;
        }
        node.classList.toggle("on", state.selected === id);
        node.classList.toggle("gate", card.activity === "needs_human");
        node.classList.toggle("human", card.kind === "human");
        node.classList.toggle("wait", card.activity === "waiting");
        node.classList.toggle("handed", card.activity === "handoff");
        node.classList.toggle("ok", card.activity === "accepted");
        node.classList.toggle("lit", focusActor !== "" && card.owner === focusActor);
        node.classList.toggle(
          "busy",
          card.activity === "working" || card.activity === "reviewing",
        );
        const owner = node.querySelector(`[data-owner="${id}"]`);
        const title = node.querySelector(".title");
        const now = node.querySelector(".now");
        const act = node.querySelector(`[data-act="${id}"]`);
        const you = node.querySelector(`[data-you="${id}"]`);
        const bot = node.querySelector(`[data-bot="${id}"]`);
        const spin = node.querySelector(`[data-spin="${id}"]`);
        const out = node.querySelector(`[data-out="${id}"]`);
        const pass = node.querySelector(`[data-pass="${id}"]`);
        if (owner) {
          owner.textContent = card.owner;
        }
        if (title) {
          title.textContent = card.title;
        }
        if (now) {
          now.textContent = card.now;
        }
        if (act) {
          act.textContent = labelActivity(card.activity);
        }
        if (you) {
          you.textContent = formatClock(card.humanSeconds);
        }
        if (bot) {
          bot.textContent = formatClock(card.agentSeconds);
        }
        if (out) {
          out.textContent = card.checkout;
        }
        if (spin instanceof HTMLElement) {
          spin.hidden = card.activity !== "working" && card.activity !== "reviewing";
        }
        if (pass instanceof HTMLElement) {
          if (card.previous) {
            pass.hidden = false;
            pass.textContent = `${card.previous} to ${card.owner}`;
          } else {
            pass.hidden = true;
          }
        }
      });

      const need = state.cards.filter((card) => card.activity === "needs_human").length;
      const needNode = root.querySelector("[data-need]");
      if (needNode) {
        needNode.textContent = String(need);
      }
      const spent = boardSpend(state.cards);
      const spendYou = root.querySelector("[data-spend-you]");
      const spendAgents = root.querySelector("[data-spend-agents]");
      if (spendYou) {
        spendYou.textContent = formatClock(spent.human);
      }
      if (spendAgents) {
        spendAgents.textContent = formatClock(spent.agent);
      }

      const crew = presence({
        ...state,
        thread: beat === 2 && typed !== TIMO_ANSWER
          ? {
              from: "Claude",
              to: "Timo",
              question: state.thread?.question ?? "",
              answer: null,
              typing: true,
            }
          : state.thread,
      });
      for (const item of crew) {
        const mode = root.querySelector(`[data-mode="${item.actor}"]`);
        const dot = root.querySelector(`[data-dot="${item.actor}"]`);
        const btn = root.querySelector(`[data-actor="${item.actor}"]`);
        if (mode) {
          mode.textContent = item.mode;
        }
        if (dot instanceof HTMLElement) {
          dot.dataset.mode = item.mode;
        }
        if (btn instanceof HTMLElement) {
          btn.classList.toggle("on", focusActor === item.actor);
          btn.dataset.mode = item.mode;
        }
      }

      const gate = attention({
        ...state,
        thread: beat === 2 && typed !== TIMO_ANSWER
          ? {
              from: "Claude",
              to: "Timo",
              question: state.thread?.question ?? "",
              answer: null,
              typing: true,
            }
          : state.thread,
      });
      const att = root.querySelector("[data-attention]");
      if (att instanceof HTMLElement) {
        att.hidden = gate === null;
        att.classList.toggle("talk", gate?.kind === "answering");
        if (gate) {
          const k = att.querySelector("[data-att-k]");
          const who = att.querySelector("[data-att-who]");
          const title = att.querySelector("[data-att-title]");
          const why = att.querySelector("[data-att-why]");
          const go = att.querySelector("[data-att-go]");
          if (k) {
            k.textContent = gate.kind === "needed" ? "Human needed" : "Timo answering";
          }
          if (who) {
            who.textContent = `${gate.from} to ${gate.to} · ${gate.pack}`;
          }
          if (title) {
            title.textContent = gate.title;
          }
          if (why) {
            why.textContent = gate.why;
          }
          if (go) {
            go.textContent = gate.kind === "needed" ? "Answer" : "Watch";
          }
        }
      }

      const question = root.querySelector("[data-question]");
      const typing = root.querySelector("[data-typing]");
      const answer = root.querySelector("[data-answer]");
      const answers = root.querySelector("[data-answers]");
      const blurb = root.querySelector("[data-blurb]");
      const log = root.querySelector("[data-log]");
      const route = root.querySelector("[data-route]");
      const hash = root.querySelector("[data-hash]");
      const selected = state.cards.find((card) => card.id === state.selected);

      if (route instanceof HTMLElement) {
        route.hidden = !state.thread;
        if (state.thread) {
          route.textContent = `${state.thread.from} to ${state.thread.to} · request_human`;
        }
      }
      if (question instanceof HTMLElement) {
        question.hidden = !state.thread;
        if (state.thread) {
          question.textContent = state.thread.question;
        }
      }
      if (typing instanceof HTMLElement) {
        typing.hidden = beat !== 2 || typed === TIMO_ANSWER;
      }
      const head = root.querySelector("[data-k]");
      if (head) {
        head.textContent = state.thread ? "Thread" : "Inspect";
      }
      if (answer instanceof HTMLElement) {
        const text = typed || state.thread?.answer || "";
        answer.textContent = text;
        answer.classList.toggle("caret", beat === 2 && typed !== TIMO_ANSWER && text.length > 0);
        answer.hidden = text.length === 0;
      }
      if (answers instanceof HTMLElement) {
        answers.hidden = beat !== 1;
      }
      if (blurb) {
        blurb.textContent = selected
          ? (INSPECT[selected.id] ?? selected.now)
          : "Click a card.";
      }
      const cardSpend = root.querySelector("[data-card-spend]");
      if (cardSpend instanceof HTMLElement) {
        if (selected) {
          cardSpend.hidden = false;
          cardSpend.textContent = `human ${formatClock(selected.humanSeconds)} · agent ${formatClock(selected.agentSeconds)}`;
        } else {
          cardSpend.hidden = true;
        }
      }
      if (hash && selected) {
        hash.textContent = selected.checkout;
      }
      if (log) {
        log.replaceChildren(
          ...state.log.slice(-7).map((line) => {
            const item = document.createElement("li");
            const who = document.createElement("b");
            who.textContent = line.actor;
            item.append(who, document.createTextNode(` ${line.text}`));
            return item;
          }),
        );
      }

      const live = root.querySelector("[data-live]");
      if (live instanceof HTMLElement) {
        live.classList.toggle("on", !paused);
        live.setAttribute("aria-pressed", paused ? "false" : "true");
      }

      const sess = root.querySelector("[data-session]");
      if (sess) {
        sess.textContent = formatClock(session);
      }

      if (!root.dataset.lockedHint) {
        toast(BEAT_HINTS[beat] ?? BEAT_HINTS[0]);
      }
    };

    const arm = () => {
      window.clearTimeout(timer);
      if (paused || reduce || !visible || document.hidden) {
        return;
      }
      if (beat >= BEATS.length - 1) {
        return;
      }
      timer = window.setTimeout(() => goto(nextBeat(beat)), dwellFor(beat));
    };

    const goto = (next: number) => {
      beat = Math.max(0, Math.min(BEATS.length - 1, next));
      typed = beat >= 2 ? TIMO_ANSWER : "";
      state = snapshot(beat, egg);
      root.dataset.lockedHint = "";
      if (beat === 2 && !reduce) {
        typed = "";
        state.thread = {
          from: "Claude",
          to: "Timo",
          question: state.thread?.question ?? "",
          answer: null,
          typing: true,
        };
        window.clearInterval(typeTimer);
        typeTimer = window.setInterval(() => {
          typed = TIMO_ANSWER.slice(0, typed.length + 1);
          const a01 = state.cards.find((card) => card.id === "a01");
          if (a01) {
            a01.now = "Timo is answering Claude.";
          }
          if (typed === TIMO_ANSWER) {
            window.clearInterval(typeTimer);
            state.thread = {
              from: "Claude",
              to: "Timo",
              question: state.thread?.question ?? "",
              answer: TIMO_ANSWER,
              typing: false,
            };
            if (a01) {
              a01.now = "Claude resumed with Timo's bootstrap policy.";
            }
          }
          paint();
        }, 22);
      }
      paint();
      arm();
    };

    const onClick = (event: Event) => {
      const target = event.target;
      if (!(target instanceof Element)) {
        return;
      }
      const liveBtn = target.closest("[data-live]");
      if (liveBtn) {
        paused = !paused;
        root.dataset.lockedHint = "1";
        toast(paused ? "You paused the board." : "The board is moving again.");
        paint();
        arm();
        return;
      }
      if (target.closest("[data-space]")) {
        root.dataset.lockedHint = "1";
        toast("The board is free. Host your own.");
        return;
      }
      if (target.closest("[data-hash]")) {
        root.dataset.lockedHint = "1";
        toast("Exact checkout. Not a guess.");
        return;
      }
      if (target.closest("[data-need-btn]")) {
        goto(1);
        return;
      }
      if (target.closest("[data-attention]")) {
        state.selected = "a01";
        if (beat === 0) {
          goto(1);
          return;
        }
        paint();
        return;
      }
      if (target.closest("[data-replay]")) {
        egg = "none";
        focusActor = "";
        root.dataset.lockedHint = "1";
        toast("Replay from the live board.");
        goto(0);
        return;
      }
      const actorBtn = target.closest("[data-actor]");
      if (actorBtn instanceof HTMLElement) {
        const actor = actorBtn.dataset.actor ?? "";
        if (actor === "Timo") {
          timoHits += 1;
          if (beat === 2 && typed !== TIMO_ANSWER) {
            root.dataset.lockedHint = "1";
            toast("He's already typing.");
            return;
          }
          if (timoHits === 5) {
            root.dataset.lockedHint = "1";
            toast("Operator is already on the board.");
          }
        }
        focusActor = focusActor === actor ? "" : actor;
        const owned = state.cards.find((card) => card.owner === actor);
        if (owned) {
          state.selected = owned.id;
        }
        paint();
        return;
      }
      const beatBtn = target.closest("[data-beat]");
      if (beatBtn instanceof HTMLElement) {
        goto(Number(beatBtn.dataset.beat));
        return;
      }
      const cardBtn = target.closest("[data-card]");
      if (cardBtn instanceof HTMLElement) {
        const id = cardBtn.dataset.card ?? "";
        state.selected = id;
        if (id === "c05" || id === "l01") {
          adinaHits += 1;
          if (adinaHits === 3) {
            root.dataset.lockedHint = "1";
            toast("Adina is in the CLI. She does not file tickets.");
          }
        }
        if (id === "x03a" && event instanceof MouseEvent && event.detail >= 2) {
          root.dataset.lockedHint = "1";
          toast("Grok can review. No human permission is required.");
          beat = 4;
          state = snapshot(4, egg);
          state.selected = "x03a";
        }
        paint();
        return;
      }
      const say = target.closest("[data-say]");
      if (say instanceof HTMLElement) {
        const kind = say.dataset.say;
        root.dataset.lockedHint = "1";
        if (kind === "safe") {
          toast("Answer committed. Claude can move.");
          goto(2);
          return;
        }
        if (kind === "wrong") {
          toast("That is how tickets work. Try again.");
          paint();
          return;
        }
        if (kind === "shell") {
          toast("A heartbeat is not work. A shell is not BFB.");
          paint();
        }
      }
    };

    const onKey = (event: KeyboardEvent) => {
      keys = (keys + event.key).slice(-Math.max(konami.length, 8));
      if (keys.endsWith(konami)) {
        egg = "runner";
        root.dataset.lockedHint = "1";
        toast("You woke Timo's Mac Studio.");
        state = snapshot(beat, egg);
        state.selected = "wake";
        paint();
      }
      if (/qdis$/i.test(keys.slice(-4))) {
        root.dataset.lockedHint = "1";
        toast("Operator is already on the board.");
      }
      if (beat === 1 && /shell$/i.test(keys.slice(-5))) {
        root.dataset.lockedHint = "1";
        toast("No shell. Ever.");
      }
      if (!root.matches(":hover, :focus-within")) {
        return;
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        goto(nextBeat(beat));
      }
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        goto(beat - 1);
      }
    };

    const clocks = window.setInterval(() => {
      if (paused || !visible) {
        return;
      }
      session += 1;
      for (const card of state.cards) {
        tickWorkingCard(card);
      }
      paint();
    }, 1000);

    const pings = window.setInterval(() => {
      if (paused || !visible) {
        return;
      }
      const ping = root.querySelector("[data-ping]");
      if (ping) {
        ping.textContent = `${18 + Math.floor(Math.random() * 37)}ms`;
      }
    }, 1800);

    const io = new IntersectionObserver(
      (entries) => {
        const hit = entries.some((entry) => entry.isIntersecting);
        if (hit && !visible) {
          visible = true;
          paint();
          arm();
        }
      },
      { threshold: 0.28 },
    );
    io.observe(root);

    root.addEventListener("click", onClick);
    window.addEventListener("keydown", onKey);
    document.addEventListener("visibilitychange", arm);
    paint();

    window.addEventListener(
      "pagehide",
      () => {
        window.clearTimeout(timer);
        window.clearInterval(typeTimer);
        window.clearInterval(clocks);
        window.clearInterval(pings);
        io.disconnect();
        root.removeEventListener("click", onClick);
        window.removeEventListener("keydown", onKey);
        document.removeEventListener("visibilitychange", arm);
      },
      { once: true },
    );
  }
</script>

<style>
  .demo {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-panel);
    background: var(--chamber);
    overflow: hidden;
  }

  .toolbar,
  .beats,
  .hint,
  .crew,
  .row,
  .meta,
  .acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.85rem;
  }

  .toolbar {
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--hairline);
    color: var(--smoke);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .toolbar b,
  .stat b {
    color: var(--bone);
    font-weight: 600;
  }

  .crew {
    gap: 0.35rem;
  }

  .crew button,
  .live,
  .ghost,
  .stat,
  .beats button,
  .acts button,
  .card,
  .attention {
    font: inherit;
    cursor: pointer;
    color: inherit;
    background: transparent;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-control);
  }

  .crew button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.22rem 0.45rem;
    text-transform: uppercase;
  }

  .crew button span {
    color: var(--smoke);
    font-size: 0.62rem;
  }

  .crew button.on {
    border-color: color-mix(in oklab, var(--bone) 30%, var(--hairline));
    background: var(--raised);
    color: var(--bone);
  }

  .crew i {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    background: color-mix(in oklab, var(--bone) 28%, var(--hairline));
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--bone) 22%, transparent);
  }

  .crew i[data-mode="working"],
  .crew i[data-mode="reviewing"],
  .crew i[data-mode="handoff"] {
    background: var(--safelight);
    box-shadow: 0 0 0.55rem color-mix(in oklab, var(--crimson) 80%, transparent);
  }

  .crew i[data-mode="needed"],
  .crew i[data-mode="waiting"],
  .crew i[data-mode="answering"] {
    background: var(--safelight);

---
// ABOUTME: Carded product demo after the hero. Smaller than the page, clearly framed.
// ABOUTME: The board is a preview of the product, not the page itself.

import DemoBoard from "./DemoBoard.astro";
import { COPY } from "../lib/copy";

const { headline, body } = COPY.demo;
---

<section class="demo-sec" id="demo">
  <div class="wrap">
    <h2>{headline}</h2>
    <p>{body}</p>
    <figure class="preview">
      <figcaption>Embedded preview</figcaption>
      <DemoBoard />
    </figure>
  </div>
</section>

<style>
  .demo-sec {
    padding: 4.5rem 0 5.5rem;
    background: var(--blackout);
    border-top: 1px solid var(--hairline);
  }

  h2 {
    margin: 0 0 0.7rem;
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  p {
    margin: 0 0 1.6rem;
    max-width: 52ch;
    color: var(--smoke);
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .preview {
    container-type: inline-size;
    width: min(100%, 72rem);
    margin: 0 auto;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-panel);
    background: var(--chamber);
    overflow: hidden;
    box-shadow: 0 22px 56px oklch(0.02 0.01 26 / 0.8);
  }

  figcaption {
    margin: 0;
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid var(--hairline);
    background: var(--blackout);
    color: var(--smoke);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .preview :global(.lanes) {
    grid-template-columns: 1fr;
  }

  .preview :global(.inspect) {
    grid-template-columns: 1fr;
  }

  .preview :global(.crew button span),
  .preview :global(.ping),
  .preview :global(.sess) {
    display: none;
  }

  @container (min-width: 42rem) {
    .preview :global(.lanes) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .preview :global(.inspect) {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
  }

  @media (min-width: 768px) {
    .demo-sec {
      padding: 5.5rem 0 6.5rem;
    }
  }
</style>

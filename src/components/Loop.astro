---
// ABOUTME: Five-verb path from create to accept, not numbered stages.
// ABOUTME: Horizontal on desktop, stacked on small screens.

import { COPY } from "../lib/copy";
---

<section class="loop" id="how">
  <h2>{COPY.loop.headline}</h2>
  <ol>
    {
      COPY.loop.steps.map((step) => (
        <li>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .loop {
    padding: 5rem 1.25rem 5.25rem;
    background: var(--chamber);
    border-top: 1px solid var(--hairline);
  }

  h2 {
    margin: 0 0 1.8rem;
    max-width: 20ch;
    font-size: clamp(1.9rem, 4vw, 3.1rem);
    font-weight: 650;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  ol {
    display: grid;
    gap: 1.4rem 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding-top: 1.1rem;
    border-top: 1px solid var(--hairline);
  }

  h3 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  p {
    margin: 0;
    max-width: 28ch;
    color: var(--smoke);
    line-height: 1.45;
  }

  @media (min-width: 768px) {
    .loop {
      padding: 6.25rem 2rem 6.5rem;
    }

    ol {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0;
    }

    li {
      padding: 1.2rem 1rem 0 0;
      border-top: 0;
      border-right: 1px solid var(--hairline);
    }

    li:last-child {
      border-right: 0;
      padding-right: 0;
    }
  }
</style>

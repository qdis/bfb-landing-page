---
// ABOUTME: Document shell for the single Big Fat Board coming-soon page.
// ABOUTME: Writes title, description, canonical, Open Graph, and llms.txt link.

import "@fontsource/geologica/latin-400.css";
import "@fontsource/geologica/latin-500.css";
import "@fontsource/geologica/latin-600.css";
import "@fontsource/geologica/latin-700.css";
import "@fontsource/azeret-mono/latin-500.css";
import "@fontsource/azeret-mono/latin-600.css";
import { COPY, OG_IMAGE, SITE_NAME, THEME_COLOR } from "../lib/copy";
import { absoluteUrl } from "../lib/site";

interface Props {
  path?: string;
}

const path = Astro.props.path ?? "/";
const origin = Astro.site ?? "https://bigfatboard.com";
const canonical = absoluteUrl(path, origin);
const title = `${SITE_NAME} - Coming soon`;
const description = COPY.description;
const ogImage = absoluteUrl(OG_IMAGE, origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="describedby" href={absoluteUrl("/llms.txt", origin)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="index,follow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <!--
      THESIS: One darkroom waitlist. The product plane is the hero. Refuses variant galleries, GitHub marketing, and three-card SaaS.
      OWN-WORLD: Blackout canvas, deep oxblood field, scarce crimson controls, Geologica voice, Azeret only for machine facts.
      STORY: Visitor sees the board working, learns what BFB is and solves, leaves an email.
      FIRST VIEWPORT: 64px masthead, THE TICKET ERA IS OVER on the left, perspective control plane bleeding right and bottom, Get BFB as the only action.
      FORM: Pinned Redline Control Room mockup; seed key pinned-mockup (user-locked, no concept-seed).
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <a class="skip" href="#signup">Skip to email signup</a>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --blackout: oklch(0.135 0.014 26);
    --chamber: oklch(0.185 0.024 27);
    --raised: oklch(0.235 0.032 27);
    --bone: oklch(0.945 0.010 72);
    --smoke: oklch(0.705 0.018 35);
    --crimson: oklch(0.464 0.169 26.9);
    --safelight: oklch(0.625 0.190 27);
    --hairline: oklch(0.335 0.040 27);
    --oxblood: oklch(0.22 0.09 26);
    --oxblood-deep: oklch(0.16 0.055 26);
    --font-sans: "Geologica", "Arial Narrow", Arial, sans-serif;
    --font-mono: "Azeret Mono", ui-monospace, monospace;
    --radius-control: 4px;
    --radius-panel: 8px;
    --nav-h: 64px;
    --signup-line: var(--hairline);
    --signup-radius: var(--radius-control);
    --signup-field: var(--raised);
    --signup-ink: var(--bone);
    --signup-muted: var(--smoke);
    --signup-accent: var(--crimson);
    --signup-on-accent: var(--bone);
    --signup-error: oklch(0.78 0.12 26);
    --signup-ok: var(--bone);
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    background: var(--blackout);
    color: var(--bone);
  }

  html {
    scrollbar-color: var(--crimson) var(--blackout);
  }

  body {
    min-height: 100dvh;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    caret-color: var(--crimson);
  }

  img {
    max-width: 100%;
    display: block;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  #top,
  #product,
  #solves,
  #promises,
  #how,
  #signup {
    scroll-margin-top: var(--nav-h);
  }

  button,
  input {
    font: inherit;
  }

  .skip {
    position: absolute;
    left: 0.75rem;
    top: -3rem;
    z-index: 20;
    padding: 0.5rem 0.75rem;
    background: var(--chamber);
    color: var(--bone);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-control);
  }

  .skip:focus {
    top: 0.75rem;
  }

  :focus-visible {
    outline: 2px solid var(--bone);
    outline-offset: 2px;
  }

  ::selection {
    background: color-mix(in oklab, var(--crimson) 42%, transparent);
    color: var(--bone);
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>

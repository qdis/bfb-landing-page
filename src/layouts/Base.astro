---
// ABOUTME: Document shell for the single Big Fat Board coming-soon page.
// ABOUTME: Writes title, description, canonical, Open Graph, and llms.txt link.

import "@fontsource/unbounded/latin-700.css";
import "@fontsource/unbounded/latin-800.css";
import "@fontsource/anybody/latin-400.css";
import "@fontsource/anybody/latin-500.css";
import "@fontsource/anybody/latin-600.css";
import "@fontsource/azeret-mono/latin-500.css";
import "@fontsource/azeret-mono/latin-600.css";
import { COPY, OG_IMAGE, SITE_NAME, THEME_COLOR } from "../lib/copy";
import { absoluteUrl } from "../lib/site";

interface Props {
  path?: string;
}

const path = Astro.props.path ?? "/";
const origin = Astro.site ?? "https://bigfatboard.com";
const canonical = absoluteUrl(path, origin);
const title = `${SITE_NAME} - Coming soon`;
const description = COPY.description;
const ogImage = absoluteUrl(OG_IMAGE, origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="describedby" href={absoluteUrl("/llms.txt", origin)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="index,follow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <!--
      THESIS: Mission statement plus a live board. Refuses ticket-era ceremony and single-vendor remotes.
      OWN-WORLD: Near-black canvas, scarce crimson, Unbounded death lines, Anybody body, Azeret for machine facts.
      STORY: Jira and Scrum are dead. AI-first companies need a control plane. Leave an email.
      FIRST VIEWPORT: JIRA IS DEAD / SCRUM IS DEAD / AI-FIRST COMPANIES NEED A CONTROL PLANE. Full-width hero, then the live scripted board.
      FORM: Pinned Redline world, darkened; seed key pinned-mockup plus Timo 2026-08-18 brief.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <a class="skip" href="#signup">Skip to email signup</a>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --blackout: oklch(0.08 0.006 26);
    --chamber: oklch(0.12 0.012 27);
    --raised: oklch(0.16 0.018 27);
    --bone: oklch(0.93 0.008 80);
    --smoke: oklch(0.6 0.012 35);
    --crimson: oklch(0.42 0.155 26);
    --safelight: oklch(0.58 0.175 27);
    --hairline: oklch(0.22 0.018 27);
    --oxblood: oklch(0.13 0.05 26);
    --oxblood-deep: oklch(0.09 0.035 26);
    --font-display: "Unbounded", "Arial Narrow", sans-serif;
    --font-sans: "Anybody", Arial, sans-serif;
    --font-mono: "Azeret Mono", ui-monospace, monospace;
    --radius-control: 4px;
    --radius-panel: 8px;
    --nav-h: 64px;
    --page: 87.5rem;
    --signup-line: var(--hairline);
    --signup-radius: var(--radius-control);
    --signup-field: var(--raised);
    --signup-ink: var(--bone);
    --signup-muted: var(--smoke);
    --signup-accent: var(--crimson);
    --signup-on-accent: var(--bone);
    --signup-error: oklch(0.78 0.12 26);
    --signup-ok: var(--bone);
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    background: var(--blackout);
    color: var(--bone);
  }

  html {
    scrollbar-color: var(--crimson) var(--blackout);
  }

  body {
    min-height: 100dvh;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    caret-color: var(--crimson);
  }

  img {
    max-width: 100%;
    display: block;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .wrap {
    width: min(100% - 2rem, var(--page));
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .wrap {
      width: min(100% - 3rem, var(--page));
    }
  }

  #top,
  #demo,
  #product,
  #solves,
  #promises,
  #how,
  #local,
  #signup {
    scroll-margin-top: var(--nav-h);
  }

  button,
  input {
    font: inherit;
  }

  .skip {
    position: absolute;
    left: 0.75rem;
    top: -3rem;
    z-index: 20;
    padding: 0.5rem 0.75rem;
    background: var(--chamber);
    color: var(--bone);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-control);
  }

  .skip:focus {
    top: 0.75rem;
  }

  :focus-visible {
    outline: 2px solid var(--bone);
    outline-offset: 2px;
  }

  ::selection {
    background: color-mix(in oklab, var(--crimson) 42%, transparent);
    color: var(--bone);
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>

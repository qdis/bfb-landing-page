---
// ABOUTME: Public Notice landing from the BFB design study on origin/design/landing-directions.
// ABOUTME: Municipal paper, Archivo Black, one crimson overprint, edge-attached project board.

import "@fontsource/archivo-black";
import "@fontsource/archivo/400.css";
import "@fontsource/archivo/700.css";
import FeatureIndex from "../components/FeatureIndex.astro";
import NoticeBoard from "../components/NoticeBoard.astro";
import RivalIndex from "../components/RivalIndex.astro";
import SignupForm from "../components/SignupForm.astro";
import VariantSwitch from "../components/VariantSwitch.astro";
import { COPY, type Variant } from "../lib/copy";

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;
const copy = COPY;
const source = "https://github.com/qdis/bfb";
---

<div class="notice">
  <header>
    <a class="mark" href="/">{copy.shortName} / {copy.name}</a>
    <VariantSwitch current={variant} />
    <a class="enter" href="#signup">Enter board</a>
  </header>
  <section class="hero">
    <p class="soon">{copy.comingSoon}</p>
    <h1>Your agents are working. Your tickets are guessing.</h1>
    <p class="sub">See who works where, what needs you, and what can go straight to another agent.</p>
    <div class="actions">
      <a class="use" href="#signup">Use BFB</a>
      <a class="src" href={source}>View source</a>
    </div>
  </section>
  <NoticeBoard />
  <main>
    <p class="dead">{copy.claims.traditionalDead} {copy.claims.jiraDead}</p>
    <p>{copy.claims.aiNative}</p>
    <p>{copy.claims.timeTracking}</p>
    <p>{copy.claims.remoteStart}</p>
    <p>{copy.claims.trio}</p>
    <p class="dry">The ticket says IN PROGRESS. BFB says Claude needs you.</p>
    <RivalIndex />
    <ol>
      {copy.loop.steps.map((step) => <li>{step}</li>)}
    </ol>
    <FeatureIndex />
    <section id="signup">
      <h2>Use BFB</h2>
      <p>{copy.scale}</p>
      <SignupForm />
    </section>
  </main>
  <footer>
    Use BFB. Fork it. Or build your own.
  </footer>
</div>

<style>
  .notice {
    --signup-field: oklch(0.985 0.005 70);
    --signup-ink: oklch(0.145 0.012 25);
    --signup-line: oklch(0.145 0.012 25);
    --signup-accent: oklch(0.464 0.169 26.9);
    --signup-on-accent: oklch(0.985 0.005 70);
    --signup-muted: oklch(0.32 0.02 27);
    --signup-radius: 0;
    --signup-error: oklch(0.29 0.11 27);
    min-height: 100dvh;
    background: oklch(0.985 0.005 70);
    color: oklch(0.145 0.012 25);
    font-family: Archivo, Arial, sans-serif;
    font-weight: 400;
  }

  .notice::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 40;
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  header,
  .hero,
  main,
  footer {
    position: relative;
    z-index: 1;
  }

  header {
    min-height: 64px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 0 1.1rem;
    border-bottom: 1px solid oklch(0.145 0.012 25);
  }

  .mark {
    font-family: "Archivo Black", "Arial Black", sans-serif;
    text-decoration: none;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .enter {
    background: oklch(0.464 0.169 26.9);
    color: oklch(0.985 0.005 70);
    text-decoration: none;
    padding: 0.7rem 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .hero {
    padding: 1.4rem 1.1rem 1.6rem;
  }

  .soon {
    margin: 0 0 0.45rem;
    font-weight: 700;
    font-size: 0.9rem;
  }

  h1 {
    margin: 0;
    font-family: "Archivo Black", "Arial Black", sans-serif;
    font-weight: 400;
    font-size: clamp(2.6rem, 7vw, 5.6rem);
    letter-spacing: -0.03em;
    line-height: 0.9;
    max-width: 16ch;
    clip-path: inset(0 0 0 0);
    animation: print 450ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .sub {
    margin: 0.85rem 0 1.1rem;
    max-width: 42ch;
    font-size: 1.15rem;
    line-height: 1.35;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .use,
  .src {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.7rem 1.1rem;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.82rem;
  }

  .use {
    background: oklch(0.145 0.012 25);
    color: oklch(0.985 0.005 70);
  }

  .use:hover {
    background: oklch(0.464 0.169 26.9);
  }

  .src {
    border: 1px solid oklch(0.145 0.012 25);
  }

  main {
    padding: 2.4rem 1.1rem 3.5rem;
    display: grid;
    gap: 0.9rem;
    width: min(980px, 100%);
  }

  main > p {
    margin: 0;
    max-width: 62ch;
    line-height: 1.45;
  }

  .dead {
    font-family: "Archivo Black", "Arial Black", sans-serif;
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 400;
    max-width: 18ch;
  }

  .dry {
    padding-top: 0.4rem;
    border-top: 8px solid oklch(0.464 0.169 26.9);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.45rem;
  }

  ol li {
    border-top: 1px solid oklch(0.145 0.012 25);
    padding-top: 0.45rem;
    max-width: 62ch;
  }

  #signup {
    padding-top: 1rem;
    max-width: 28rem;
  }

  h2 {
    margin: 0 0 0.4rem;
    font-family: "Archivo Black", "Arial Black", sans-serif;
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  footer {
    background: oklch(0.464 0.169 26.9);
    color: oklch(0.985 0.005 70);
    padding: 1.1rem 1.1rem 1.2rem;
    font-family: "Archivo Black", "Arial Black", sans-serif;
    letter-spacing: -0.02em;
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
  }

  :global(.notice ::selection) {
    background: oklch(0.464 0.169 26.9);
    color: oklch(0.985 0.005 70);
  }

  @keyframes print {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    h1 {
      animation: none;
    }
  }

  @media (max-width: 767px) {
    header {
      grid-template-columns: 1fr auto;
      min-height: 0;
      padding-top: 0.7rem;
      padding-bottom: 0.7rem;
    }

    :global(.notice .switch) {
      grid-column: 1 / -1;
      order: 3;
    }
  }
</style>

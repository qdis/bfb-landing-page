---
// ABOUTME: Warehouse stencil composition: safety yellow field and black type.
// ABOUTME: Claims read as sprayed lines; signup sits on a black plate.

import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/800.css";
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/600.css";
import FeatureIndex from "../components/FeatureIndex.astro";
import RivalIndex from "../components/RivalIndex.astro";
import SignupForm from "../components/SignupForm.astro";
import VariantSwitch from "../components/VariantSwitch.astro";
import { COPY, type Variant } from "../lib/copy";

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;
const copy = COPY;
---

<div class="stencil">
  <header>
    <VariantSwitch current={variant} />
  </header>
  <main>
    <p class="mark">{copy.comingSoon}</p>
    <h1>
      <span>Jira</span>
      <span>is</span>
      <span>dead</span>
    </h1>
    <p class="blast">{copy.claims.traditionalDead}</p>
    <ul>
      <li>{copy.claims.aiNative}</li>
      <li>{copy.claims.timeTracking}</li>
      <li>{copy.claims.remoteStart}</li>
      <li>{copy.claims.trio}</li>
    </ul>
    <RivalIndex />
    <FeatureIndex />
    <div class="dock">
      <img
        src="/images/stencil-wall.jpg"
        alt="Concrete loading-dock wall painted safety yellow"
        width="1200"
        height="800"
      />
      <section id="signup">
        <h2>Load the list</h2>
        <SignupForm />
      </section>
    </div>
  </main>
</div>

<style>
  .stencil {
    --signup-field: #111;
    --signup-ink: #f5e56a;
    --signup-line: #f5e56a;
    --signup-accent: #f5e56a;
    --signup-on-accent: #111;
    --signup-muted: #d7c45a;
    --signup-radius: 0;
    --signup-error: #ffd36a;
    min-height: 100dvh;
    background: #f0c400;
    color: #111;
    font-family: "Barlow", Arial, sans-serif;
  }

  header {
    padding: 0.9rem 1rem;
    border-bottom: 8px solid #111;
  }

  main {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.1rem 0 3.5rem;
  }

  .mark {
    margin: 0;
    font-family: "Barlow Condensed", "Arial Narrow", sans-serif;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 1rem;
  }

  h1 {
    margin: 0.15rem 0 0.4rem;
    font-family: "Barlow Condensed", "Arial Narrow", sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 0.78;
    font-size: clamp(4.4rem, 16vw, 11rem);
  }

  h1 span {
    display: block;
  }

  .blast {
    margin: 0 0 1.1rem;
    max-width: 28ch;
    font-size: 1.35rem;
    font-weight: 600;
  }

  main > ul {
    margin: 0 0 1.6rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.45rem;
    font-size: 1.15rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    max-width: 70ch;
  }

  .dock {
    display: grid;
    grid-template-columns: 1.3fr 0.9fr;
    gap: 1rem;
    align-items: stretch;
  }

  img {
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
    filter: contrast(1.1);
  }

  section {
    background: #111;
    color: #f5e56a;
    padding: 1.2rem;
  }

  h2 {
    margin: 0 0 1rem;
    font-family: "Barlow Condensed", "Arial Narrow", sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 1.6rem;
  }

  @media (max-width: 767px) {
    .dock {
      grid-template-columns: 1fr;
    }

    main > ul {
      text-transform: none;
      letter-spacing: 0;
    }
  }
</style>

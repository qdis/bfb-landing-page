---
// ABOUTME: Studio still-life of a kraft board held up with gaffer tape.
// ABOUTME: Claims sit on tape strips; signup is a sticker on the board.

import "@fontsource/archivo/600.css";
import "@fontsource/archivo/800.css";
import "@fontsource/figtree/400.css";
import "@fontsource/figtree/600.css";
import SignupForm from "../components/SignupForm.astro";
import VariantSwitch from "../components/VariantSwitch.astro";
import { COPY, type Variant } from "../lib/copy";

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;
const copy = COPY;
---

<div class="tape">
  <header>
    <VariantSwitch current={variant} />
  </header>
  <main>
    <div class="stage">
      <img
        src="/images/tape-board.jpg"
        alt="Empty kraft board taped to a charcoal studio wall"
        width="1600"
        height="1200"
      />
      <article>
        <p class="soon">{copy.comingSoon}</p>
        <h1>{copy.name}</h1>
        <p class="dead">{copy.claims.jiraDead}</p>
        <p>{copy.claims.traditionalDead}</p>
        <ul>
          <li>{copy.claims.aiNative}</li>
          <li>{copy.claims.timeTracking}</li>
          <li>{copy.claims.remoteStart}</li>
          <li>{copy.claims.trio}</li>
        </ul>
        <section id="signup">
          <SignupForm />
        </section>
      </article>
    </div>
  </main>
</div>

<style>
  .tape {
    --signup-field: #f3ead8;
    --signup-ink: #1c1916;
    --signup-line: #1c1916;
    --signup-accent: #e25a12;
    --signup-on-accent: #1c1916;
    --signup-muted: #4a433b;
    --signup-radius: 1px;
    min-height: 100dvh;
    background: #1c1916;
    color: #f3ead8;
    font-family: Figtree, Arial, sans-serif;
  }

  header {
    padding: 0.9rem 1.1rem;
  }

  main {
    width: min(1100px, calc(100% - 1.5rem));
    margin: 0 auto;
    padding: 0 0 3.5rem;
  }

  .stage {
    position: relative;
  }

  .stage > img {
    width: 100%;
    height: min(86dvh, 820px);
    object-fit: cover;
    filter: saturate(0.85);
  }

  article {
    position: absolute;
    inset: 8% 8% auto 8%;
    background: #c9a56a;
    color: #1c1916;
    padding: 1.3rem 1.3rem 1.5rem;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.35);
  }

  article::before,
  article::after {
    content: "";
    position: absolute;
    height: 22px;
    background: #111;
    transform: rotate(-2deg);
  }

  article::before {
    top: -10px;
    left: 12%;
    width: 28%;
  }

  article::after {
    top: -8px;
    right: 14%;
    width: 22%;
    background: #e25a12;
    transform: rotate(3deg);
  }

  .soon {
    margin: 0;
    font-family: Archivo, Arial, sans-serif;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.78rem;
  }

  h1 {
    margin: 0.35rem 0 0.5rem;
    font-family: Archivo, Arial, sans-serif;
    font-weight: 800;
    font-size: clamp(2.2rem, 6vw, 4.2rem);
    letter-spacing: -0.035em;
    line-height: 0.9;
  }

  .dead {
    margin: 0 0 0.55rem;
    font-size: 1.35rem;
    font-weight: 650;
  }

  article > p:nth-of-type(3) {
    margin: 0 0 0.9rem;
    max-width: 42ch;
  }

  ul {
    margin: 0 0 1.1rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.45rem;
  }

  li {
    background: #111;
    color: #f3ead8;
    padding: 0.45rem 0.6rem;
    transform: rotate(-0.4deg);
    max-width: 62ch;
  }

  li:nth-child(even) {
    transform: rotate(0.5deg);
    background: #e25a12;
    color: #1c1916;
  }

  @media (max-width: 767px) {
    .stage > img {
      height: 220px;
    }

    article {
      position: relative;
      inset: auto;
      margin-top: -2.5rem;
    }
  }
</style>

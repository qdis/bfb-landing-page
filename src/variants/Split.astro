---
// ABOUTME: Asymmetric indictment split: black wall of type, bone signup column.
// ABOUTME: Claims stack as a charge sheet on the right, not as cards.

import "@fontsource-variable/geist";
import SignupForm from "../components/SignupForm.astro";
import VariantSwitch from "../components/VariantSwitch.astro";
import { COPY, type Variant } from "../lib/copy";

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;
const copy = COPY;
---

<div class="split">
  <aside>
    <p>{copy.comingSoon}</p>
    <h1>
      Jira
      <em>is</em>
      dead
    </h1>
    <img
      src="/images/split-metal.jpg"
      alt="Dark brushed metal wall used as the indictment field"
      width="1400"
      height="1800"
    />
  </aside>
  <div class="sheet">
    <header>
      <VariantSwitch current={variant} />
    </header>
    <main>
      <p class="name">{copy.name}</p>
      <p class="charge">{copy.claims.traditionalDead}</p>
      <ol>
        <li>{copy.claims.aiNative}</li>
        <li>{copy.claims.timeTracking}</li>
        <li>{copy.claims.remoteStart}</li>
        <li>{copy.claims.trio}</li>
      </ol>
      <section id="signup">
        <h2>Hold a seat</h2>
        <SignupForm />
      </section>
    </main>
  </div>
</div>

<style>
  .split {
    --signup-field: #efece6;
    --signup-ink: #161616;
    --signup-line: #161616;
    --signup-accent: #b54a2d;
    --signup-on-accent: #f7f3ec;
    --signup-muted: #4d4944;
    --signup-radius: 2px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    min-height: 100dvh;
    background: #efece6;
    color: #161616;
    font-family: Geist, "Geist Variable", Arial, sans-serif;
  }

  aside {
    position: relative;
    background: #161616;
    color: #efece6;
    overflow: hidden;
    min-height: 100dvh;
    padding: 1.4rem 1.3rem 2rem;
  }

  aside img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.28;
  }

  aside p,
  aside h1 {
    position: relative;
    z-index: 1;
  }

  aside p {
    margin: 0;
    font-size: 0.95rem;
  }

  h1 {
    margin: 1.4rem 0 0;
    font-size: clamp(4.5rem, 10vw, 8.6rem);
    font-weight: 650;
    letter-spacing: -0.05em;
    line-height: 0.82;
    max-width: 7ch;
  }

  h1 em {
    display: block;
    font-style: italic;
    font-weight: 450;
    padding-bottom: 0.08em;
  }

  .sheet {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  header {
    padding: 1rem 1.2rem 0;
  }

  main {
    padding: 2rem 1.4rem 3rem;
    display: grid;
    align-content: center;
    gap: 1rem;
  }

  .name {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .charge {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.15rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    max-width: 16ch;
  }

  ol {
    margin: 0.4rem 0 0.6rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.85rem;
  }

  li {
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid #161616;
    max-width: 46ch;
    line-height: 1.4;
  }

  h2 {
    margin: 0 0 0.7rem;
    font-size: 1.05rem;
    font-weight: 600;
  }

  @media (max-width: 767px) {
    .split {
      grid-template-columns: 1fr;
    }

    aside {
      min-height: 42dvh;
    }
  }
</style>

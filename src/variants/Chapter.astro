---
// ABOUTME: Institutional chaptered landing after Aleph Alpha's numbered manifesto.
// ABOUTME: Full-viewport stacked claims, then sober chapters of product truth.

import "@fontsource/manrope/400.css";
import "@fontsource/manrope/500.css";
import "@fontsource/manrope/700.css";
import "@fontsource/manrope/800.css";
import FeatureIndex from "../components/FeatureIndex.astro";
import RivalIndex from "../components/RivalIndex.astro";
import SignupForm from "../components/SignupForm.astro";
import VariantSwitch from "../components/VariantSwitch.astro";
import { COPY, type Variant } from "../lib/copy";

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;
const copy = COPY;
---

<div class="chapter">
  <header>
    <VariantSwitch current={variant} />
  </header>
  <section class="hero">
    <p>{copy.comingSoon}</p>
    <h1>
      Attention.
      <span>Exact checkout.</span>
      <span>Human last word.</span>
    </h1>
    <p class="sub">{copy.claims.aiNative}</p>
  </section>
  <section class="block">
    <p class="num">01 Offer</p>
    <div>
      <h2>{copy.claims.traditionalDead}</h2>
      <p>{copy.claims.jiraDead}</p>
      <RivalIndex />
    </div>
  </section>
  <section class="photo">
    <img
      src="/images/chapter-colonnade.jpg"
      alt="Empty stone colonnade in cool daylight"
      width="1600"
      height="900"
    />
  </section>
  <section class="block">
    <p class="num">02 Loop</p>
    <div>
      <h2>One place to start work and take it back.</h2>
      <ol>
        {copy.loop.steps.map((step) => <li>{step}</li>)}
      </ol>
      <p>{copy.claims.remoteStart}</p>
      <p>{copy.claims.trio}</p>
    </div>
  </section>
  <section class="split-photo">
    <img
      src="/images/chapter-table.jpg"
      alt="Institute work table with closed folders and a laptop"
      width="1200"
      height="900"
    />
    <div>
      <p class="num">03 Measure</p>
      <h2>{copy.claims.timeTracking}</h2>
      <p>{copy.boundary}</p>
    </div>
  </section>
  <section class="block">
    <p class="num">04 Board</p>
    <div>
      <h2>What we are actually building</h2>
      <FeatureIndex />
    </div>
  </section>
  <section class="block last" id="signup">
    <p class="num">05 Seat</p>
    <div>
      <h2>{copy.name} is {copy.comingSoon.toLowerCase()}.</h2>
      <p>{copy.scale}</p>
      <SignupForm />
    </div>
  </section>
</div>

<style>
  .chapter {
    --signup-field: #f7f5f0;
    --signup-ink: #1c1b19;
    --signup-line: #1c1b19;
    --signup-accent: #8a2a24;
    --signup-on-accent: #f7f5f0;
    --signup-muted: #4a4742;
    --signup-radius: 0;
    min-height: 100dvh;
    background: #efece6;
    color: #1c1b19;
    font-family: Manrope, Helvetica, Arial, sans-serif;
  }

  header {
    padding: 0.85rem 1.4rem;
  }

  .hero {
    min-height: 88dvh;
    display: grid;
    align-content: end;
    gap: 1.2rem;
    padding: 2rem 1.4rem 3.5rem;
  }

  .hero p:first-child {
    margin: 0;
    font-weight: 600;
  }

  h1 {
    margin: 0;
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.92;
    font-size: clamp(3.4rem, 9vw, 7.4rem);
    max-width: 12ch;
  }

  h1 span {
    display: block;
  }

  .sub {
    margin: 0;
    max-width: 36ch;
    font-size: 1.2rem;
    line-height: 1.35;
  }

  .block {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.5rem;
    padding: 4.5rem 1.4rem;
    border-top: 1px solid #1c1b19;
  }

  .num {
    margin: 0;
    font-weight: 600;
  }

  h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.8rem, 3.4vw, 2.7rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    font-weight: 750;
    max-width: 18ch;
  }

  .block p,
  .split-photo p {
    margin: 0 0 0.85rem;
    max-width: 62ch;
    line-height: 1.5;
    font-size: 1.05rem;
  }

  ol {
    margin: 0 0 1.1rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
    max-width: 62ch;
  }

  .photo img {
    width: 100%;
    height: min(72dvh, 720px);
    object-fit: cover;
  }

  .split-photo {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    border-top: 1px solid #1c1b19;
  }

  .split-photo img {
    width: 100%;
    height: 100%;
    min-height: 360px;
    object-fit: cover;
  }

  .split-photo div {
    padding: 3rem 1.4rem;
    display: grid;
    align-content: center;
  }

  .last {
    padding-bottom: 5rem;
  }

  :global(.chapter .features ul) {
    grid-template-columns: 1fr 1fr;
  }

  @media (max-width: 767px) {
    .block,
    .split-photo,
    :global(.chapter .features ul) {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: 72dvh;
      padding-top: 4rem;
    }
  }
</style>

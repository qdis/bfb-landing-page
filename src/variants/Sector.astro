---
// ABOUTME: Red Sector landing from the BFB design-study mockup.
// ABOUTME: Committed crimson stage, Anybody display, switcher board on the right.

import "@fontsource/anybody/700.css";
import "@fontsource/onest/400.css";
import "@fontsource/onest/600.css";
import FeatureIndex from "../components/FeatureIndex.astro";
import NoticeBoard from "../components/NoticeBoard.astro";
import RivalIndex from "../components/RivalIndex.astro";
import SignupForm from "../components/SignupForm.astro";
import VariantSwitch from "../components/VariantSwitch.astro";
import { COPY, type Variant } from "../lib/copy";

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;
const copy = COPY;
---

<div class="sector">
  <div class="stage">
    <aside>
      <a class="mark" href="/">{copy.shortName}</a>
      <p class="soon">{copy.comingSoon}</p>
      <nav>
        <a href="https://github.com/qdis/bfb/blob/main/PRODUCT.md">Product</a>
        <a href="https://github.com/qdis/bfb/blob/main/ARCHITECTURE.md">Architecture</a>
        <a href="https://github.com/qdis/bfb">Source</a>
      </nav>
      <h1>Your agents are working. Your tickets are guessing.</h1>
      <p class="sub">See who works where, what needs you, and what can go straight to another agent.</p>
      <div class="actions">
        <a class="use" href="#signup">Enter BFB</a>
        <a class="src" href="https://github.com/qdis/bfb">View source</a>
      </div>
    </aside>
    <NoticeBoard theme="sector" />
  </div>
  <div class="switch">
    <VariantSwitch current={variant} />
  </div>
  <main>
    <p>{copy.claims.traditionalDead} {copy.claims.jiraDead}</p>
    <p>{copy.claims.aiNative}</p>
    <p>{copy.claims.timeTracking}</p>
    <p>{copy.claims.remoteStart}</p>
    <p>{copy.claims.trio}</p>
    <RivalIndex />
    <FeatureIndex />
    <section id="signup">
      <h2>Enter board</h2>
      <SignupForm />
    </section>
  </main>
</div>

<style>
  .sector {
    --signup-field: #2a1010;
    --signup-ink: #f6ece4;
    --signup-line: #f6ece4;
    --signup-accent: #2a1010;
    --signup-on-accent: #f6ece4;
    --signup-muted: #f0d2c8;
    --signup-radius: 5px;
    min-height: 100dvh;
    background: oklch(0.464 0.169 26.9);
    color: #f6ece4;
    font-family: Onest, Arial, sans-serif;
  }

  .stage {
    display: grid;
    grid-template-columns: minmax(16rem, 0.72fr) 1.28fr;
    gap: 1rem;
    padding: 1.1rem;
    align-items: start;
  }

  .mark {
    font-family: Anybody, Arial, sans-serif;
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  aside nav {
    display: grid;
    gap: 0.45rem;
    margin: 1.2rem 0 1.6rem;
  }

  aside nav a {
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.78rem;
  }

  h1 {
    margin: 0;
    font-family: Anybody, Arial, sans-serif;
    font-weight: 700;
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    letter-spacing: -0.035em;
    line-height: 0.92;
    max-width: 12ch;
  }

  .soon,
  .sub {
    margin: 0.7rem 0 1rem;
    max-width: 28ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .use,
  .src {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 0.95rem;
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.78rem;
    border-radius: 5px;
  }

  .use {
    background: #f6ece4;
    color: oklch(0.32 0.12 27);
  }

  .src {
    border: 1px solid #f6ece4;
  }

  .switch {
    padding: 0 1.1rem 1rem;
  }

  main {
    background: oklch(0.32 0.11 27);
    padding: 2rem 1.1rem 3.5rem;
    display: grid;
    gap: 0.85rem;
  }

  main > p {
    margin: 0;
    max-width: 62ch;
  }

  @media (max-width: 767px) {
    .stage {
      grid-template-columns: 1fr;
    }
  }
</style>

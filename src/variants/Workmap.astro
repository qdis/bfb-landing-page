---
// ABOUTME: Work Map landing from the BFB design-study mockup.
// ABOUTME: Daylight canvas, Schibsted Grotesk, pale project-lane board.

import "@fontsource/schibsted-grotesk/400.css";
import "@fontsource/schibsted-grotesk/600.css";
import "@fontsource/schibsted-grotesk/700.css";
import "@fontsource/azeret-mono/500.css";
import FeatureIndex from "../components/FeatureIndex.astro";
import NoticeBoard from "../components/NoticeBoard.astro";
import RivalIndex from "../components/RivalIndex.astro";
import SignupForm from "../components/SignupForm.astro";
import VariantSwitch from "../components/VariantSwitch.astro";
import { COPY, type Variant } from "../lib/copy";

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;
const copy = COPY;
---

<div class="workmap">
  <header>
    <a class="mark" href="/">{copy.shortName}</a>
    <VariantSwitch current={variant} />
    <a class="enter" href="#signup">Enter board</a>
  </header>
  <section class="hero">
    <p class="soon">{copy.comingSoon}</p>
    <h1>Your agents are working. Your tickets are guessing.</h1>
    <p class="sub">See who works where, what needs you, and what can go straight to another agent.</p>
    <div class="actions">
      <a class="use" href="#signup">Open the board</a>
      <a class="src" href="https://github.com/qdis/bfb">View source</a>
    </div>
  </section>
  <div class="fixture">
    <NoticeBoard theme="paper" />
  </div>
  <main>
    <p>{copy.claims.traditionalDead} {copy.claims.jiraDead}</p>
    <p>{copy.claims.aiNative}</p>
    <p>{copy.claims.timeTracking}</p>
    <p>{copy.claims.remoteStart}</p>
    <p>{copy.claims.trio}</p>
    <RivalIndex />
    <FeatureIndex />
    <section id="signup">
      <h2>Enter board</h2>
      <SignupForm />
    </section>
  </main>
</div>

<style>
  .workmap {
    --signup-field: #fffdf8;
    --signup-ink: #221b16;
    --signup-line: #9a2b24;
    --signup-accent: #9a2b24;
    --signup-on-accent: #fffdf8;
    --signup-muted: #5b4d43;
    --signup-radius: 4px;
    min-height: 100dvh;
    background: oklch(0.976 0.005 75);
    color: oklch(0.16 0.015 30);
    font-family: "Schibsted Grotesk", Arial, sans-serif;
  }

  header {
    min-height: 64px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0 1.1rem;
    border-bottom: 1px solid oklch(0.82 0.018 30);
  }

  .mark {
    font-weight: 700;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .enter {
    background: oklch(0.464 0.169 26.9);
    color: #fffdf8;
    text-decoration: none;
    padding: 0.6rem 0.9rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.8rem;
  }

  .hero {
    padding: 1.4rem 1.1rem 1.2rem;
    width: min(1100px, 100%);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 5.2vw, 4.6rem);
    letter-spacing: -0.035em;
    line-height: 0.94;
    max-width: 16ch;
  }

  .soon {
    margin: 0 0 0.45rem;
    font-family: "Azeret Mono", ui-monospace, monospace;
    font-size: 0.78rem;
  }

  .sub {
    margin: 0.7rem 0 1rem;
    max-width: 42ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .use,
  .src {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1rem;
    text-decoration: none;
    font-weight: 700;
    border-radius: 4px;
  }

  .use {
    background: oklch(0.464 0.169 26.9);
    color: #fffdf8;
  }

  .src {
    border: 1px solid oklch(0.464 0.169 26.9);
  }

  .fixture {
    padding: 0 1.1rem 1.4rem;
  }

  main {
    padding: 0 1.1rem 3.5rem;
    display: grid;
    gap: 0.85rem;
    width: min(980px, 100%);
  }

  main > p {
    margin: 0;
    max-width: 62ch;
  }
</style>

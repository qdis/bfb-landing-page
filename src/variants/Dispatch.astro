---
// ABOUTME: Daylight dispatch-floor composition for the coming-soon landing.
// ABOUTME: Horizontal project lanes hold the claims; signup is a ticket.

import "@fontsource/schibsted-grotesk/400.css";
import "@fontsource/schibsted-grotesk/600.css";
import "@fontsource/schibsted-grotesk/700.css";
import "@fontsource/azeret-mono/500.css";
import FeatureIndex from "../components/FeatureIndex.astro";
import RivalIndex from "../components/RivalIndex.astro";
import SignupForm from "../components/SignupForm.astro";
import VariantSwitch from "../components/VariantSwitch.astro";
import { COPY, type Variant } from "../lib/copy";

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;
const copy = COPY;
const lanes = [
  { project: "Ops", claim: copy.claims.traditionalDead },
  { project: "Board", claim: copy.claims.jiraDead },
  { project: "Agents", claim: copy.claims.aiNative },
  { project: "Time", claim: copy.claims.timeTracking },
  { project: "Launch", claim: copy.claims.remoteStart },
  { project: "Talk", claim: copy.claims.trio },
];
---

<div class="dispatch">
  <header>
    <VariantSwitch current={variant} />
  </header>
  <main>
    <div class="hero">
      <div>
        <p class="status">{copy.comingSoon}</p>
        <h1>{copy.name}</h1>
        <p class="lede">
          One board. Humans and agents. No ticket cathedral.
        </p>
        <p class="rival-line">{copy.rivals.line}</p>
      </div>
      <img
        src="/images/dispatch-table.jpg"
        alt="Empty daylight dispatch table with copper lane rails"
        width="1200"
        height="900"
      />
    </div>
    <div class="lanes" aria-label="Project lanes">
      {
        lanes.map((lane) => (
          <article>
            <p class="lane">{lane.project}</p>
            <p>{lane.claim}</p>
          </article>
        ))
      }
    </div>
    <RivalIndex />
    <FeatureIndex />
    <section class="ticket" id="signup">
      <p>Take a seat on the floor</p>
      <SignupForm />
    </section>
  </main>
</div>

<style>
  .dispatch {
    --signup-field: #fffdf8;
    --signup-ink: #221b16;
    --signup-line: #c9b8a8;
    --signup-accent: #9a2b24;
    --signup-on-accent: #fffdf8;
    --signup-muted: #5b4d43;
    --signup-radius: 4px;
    min-height: 100dvh;
    background: #f3eee6;
    color: #221b16;
    font-family: "Schibsted Grotesk", Arial, sans-serif;
  }

  header {
    height: 64px;
    display: flex;
    align-items: center;
    padding: 0 1.25rem;
    border-bottom: 1px solid #d8cfc4;
  }

  main {
    width: min(1400px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.5rem 0 4rem;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 1.5rem;
    align-items: end;
    margin-bottom: 1.5rem;
  }

  .status {
    margin: 0;
    font-family: "Azeret Mono", ui-monospace, monospace;
    font-size: 0.8rem;
  }

  h1 {
    margin: 0.35rem 0 0.6rem;
    font-size: clamp(2.6rem, 6vw, 5rem);
    letter-spacing: -0.04em;
    line-height: 0.92;
  }

  .lede {
    margin: 0;
    max-width: 28ch;
    font-size: 1.2rem;
    line-height: 1.35;
    color: #4a3f38;
  }

  .rival-line {
    margin: 0.8rem 0 0;
    max-width: 46ch;
    font-size: 0.98rem;
    line-height: 1.4;
    color: #4a3f38;
  }

  img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    border-radius: 8px;
  }

  .lanes {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(220px, 1fr);
    gap: 0.75rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  article {
    min-height: 220px;
    border: 1px solid #d3c6b8;
    border-radius: 8px;
    background: #efe6db;
    padding: 0.85rem;
    border-top: 3px solid #9a2b24;
  }

  .lane {
    margin: 0 0 0.7rem;
    font-family: "Azeret Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  article p:last-child {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.35;
  }

  .ticket {
    margin-top: 1.75rem;
    max-width: 28rem;
    background: #fffdf8;
    border: 1px dashed #9a2b24;
    border-radius: 8px;
    padding: 1.1rem 1.15rem 1.25rem;
  }

  .ticket > p {
    margin: 0 0 0.85rem;
    font-weight: 650;
  }

  @media (max-width: 767px) {
    .hero {
      grid-template-columns: 1fr;
    }

    img {
      height: 180px;
    }

    .lanes {
      grid-auto-flow: row;
      grid-auto-columns: 1fr;
    }
  }
</style>

---
// ABOUTME: Broadsheet death-notice composition for the coming-soon landing.
// ABOUTME: Newsprint, serif columns, and a classified signup plate.

import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/source-sans-3";
import SignupForm from "../components/SignupForm.astro";
import VariantSwitch from "../components/VariantSwitch.astro";
import { COPY, type Variant } from "../lib/copy";

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;
const copy = COPY;
---

<div class="obit">
  <header>
    <VariantSwitch current={variant} />
  </header>
  <main>
    <p class="mast">{copy.name}</p>
    <p class="status">{copy.comingSoon}</p>
    <h1>Jira is dead</h1>
    <img
      src="/images/obit-paper.jpg"
      alt="Unprinted newsprint stacked on a composing table"
      width="1600"
      height="900"
    />
    <div class="columns">
      <p class="lede">{copy.claims.traditionalDead}</p>
      <p>{copy.claims.aiNative}</p>
      <p>{copy.claims.timeTracking}</p>
      <p>{copy.claims.remoteStart}</p>
      <p>{copy.claims.trio}</p>
    </div>
    <section class="classified" id="signup">
      <h2>Classified</h2>
      <p>Leave a work email. We will send one note when the board opens.</p>
      <SignupForm />
    </section>
  </main>
</div>

<style>
  .obit {
    --signup-field: #f4efe3;
    --signup-ink: #1b1814;
    --signup-line: #1b1814;
    --signup-accent: #7a1d1d;
    --signup-on-accent: #f4efe3;
    --signup-muted: #433c34;
    --signup-radius: 0;
    min-height: 100dvh;
    background: #d9d2c3 url("/images/obit-paper.jpg") center / cover;
    color: #1b1814;
    font-family: "Source Sans 3 Variable", "Source Sans 3", Georgia, sans-serif;
  }

  .obit::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: color-mix(in oklab, #d9d2c3 82%, transparent);
  }

  header,
  main {
    position: relative;
    z-index: 1;
  }

  header {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #1b1814;
  }

  main {
    width: min(980px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.5rem 0 4rem;
  }

  .mast {
    margin: 0;
    text-align: center;
    font-family: "Source Serif 4 Variable", "Source Serif 4", "Times New Roman", serif;
    font-size: clamp(2.4rem, 8vw, 5.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 0.9;
    border-bottom: 3px solid #1b1814;
    padding-bottom: 0.4rem;
  }

  .status {
    margin: 0.55rem 0 0;
    text-align: center;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: lowercase;
  }

  h1 {
    margin: 0.6rem 0 1.1rem;
    text-align: center;
    font-family: "Source Serif 4 Variable", "Source Serif 4", "Times New Roman", serif;
    font-size: clamp(3.2rem, 12vw, 7.4rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.86;
  }

  img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-top: 1px solid #1b1814;
    border-bottom: 1px solid #1b1814;
    filter: grayscale(0.35) contrast(1.05);
  }

  .columns {
    columns: 2 18rem;
    column-gap: 2rem;
    margin: 1.4rem 0 2.2rem;
    font-family: "Source Serif 4 Variable", "Source Serif 4", "Times New Roman", serif;
    font-size: 1.12rem;
    line-height: 1.45;
  }

  .columns p {
    margin: 0 0 0.9rem;
  }

  .lede {
    font-size: 1.35rem;
    font-weight: 650;
  }

  .classified {
    border: 1px solid #1b1814;
    padding: 1.2rem 1.2rem 1.4rem;
    background: color-mix(in oklab, #d9d2c3 70%, #fff);
    max-width: 34rem;
  }

  h2 {
    margin: 0 0 0.35rem;
    font-family: "Source Serif 4 Variable", "Source Serif 4", serif;
    font-size: 1.4rem;
  }

  .classified > p {
    margin: 0 0 1rem;
    max-width: 42ch;
  }

  @media (max-width: 767px) {
    .columns {
      columns: 1;
    }

    img {
      height: 160px;
    }
  }
</style>

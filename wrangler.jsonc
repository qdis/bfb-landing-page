{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bfb-landing-page",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "NOTIFY_EMAIL": "timo@devplant.ro",
    "FROM_EMAIL": "waitlist@bfb.sh"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bfb-signups",
      "database_id": "5b826cf2-20f8-453c-8e17-7c000db3ab6a",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["waitlist@bfb.sh"]
    }
  ],
  "routes": [
    { "pattern": "bfb.sh", "custom_domain": true },
    { "pattern": "www.bfb.sh", "custom_domain": true }
  ]
}
